# Campaign measurement policy, shared by every system. sbatch scripts require these values
# (${VAR:?}); no per-system defaults. A changed value invalidates tables measured under the old one.

# Written into RUN_META. Frozen 2026-08-03 (decision K7) until the remaining lines are measured,
# together with measure.sh, poll_peak.sh and the per-system sbatch drivers. make_steps.py may gain
# checks (re-run over every system via --check).
SNNI_POLICY_VERSION=2026-07-29.1

# ---------------------------------------------------------------------------------------------
# Recorder size floor (bytes). LLAMA dealer: top two objects invert between 256 and 64 KiB, stable
# below; 16 KiB adds 0.9 MB, no order change. Criterion: order stable over the last halving;
# re-checked per new system; `drops` must stay 0.
SNNI_PM_MIN=65536

# ---------------------------------------------------------------------------------------------
# pmsample scans every readable mapping; uncovered bytes reported as `anon:` (located, unnamed,
# not a step target). Cost scales with address space: 600 MB process 16 -> 22 ms; plus 512 GiB
# PROT_NONE 17 -> 620 ms. Unreadable mappings skipped, total printed.
SNNI_PM_FULLSCAN=1

# ---------------------------------------------------------------------------------------------
# Freeze-then-measure: SIGSTOP during capture, SIGCONT after; capture atomic for any peak width.
# Cost subtracted from wall: 2.4 to 9.6% on the LLAMA line (4 to 6 s per GiB of peak).
# README.md, "The capture is made atomic, not fast".
SNNI_PM_FREEZE=1

# ---------------------------------------------------------------------------------------------
# Poll interval (ms). Dealer: 100 ms 9.1% below the true peak, 15 ms 2.0%, frozen 0.007%; no
# measurable runtime cost. Published peak from VmHWM, independent of the interval.
POLL_MS=15

# ---------------------------------------------------------------------------------------------
# Replicates per step. Lower only via `replicates: N` with reason in MANIFEST.md (MOAI-CPU);
# every row then carries its n.
REPLICATES=3
