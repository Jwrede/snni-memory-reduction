# s2_embed_chunk: one-hot embedding matmul in 16 vocabulary chunks; carries s1. Values from the
# published RUN_META. N=16 is this campaign's parameter (retired campaign's s1). Phase B: per-chunk
# PRZS masks change the output; admitted on transcript (11,229,212,672 B, 1526 vs 1496 rounds) and a
# plaintext equivalence test.
SHAFT_LIMB_LOOP=1
SHAFT_EMBED_CHUNKS=16
