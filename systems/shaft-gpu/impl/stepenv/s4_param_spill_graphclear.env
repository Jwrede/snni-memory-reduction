# s4_param_spill_graphclear (rule-ordered line): s3_embed_chunk plus the parameter spill and the graph clear.
BASELINE_SCRIPT=$BASE/bert_perlayer_gpu.py
SHAFT_SCRIPT=bert_perlayer_gpu.py
SHAFT_LIMB_LOOP=1
SHAFT_EMBED_CHUNKS=16
SHAFT_LEVERS=param_spill_gpu,graph_clear_values_gpu
SHAFT_INNER_ENV="SHAFT_PARAM_SPILL=1 SNNI_SPILL_DIR=/results"
