# vit_v1_endpoint_r3: the ViT transfer of the rule-ordered BERT endpoint (s3_embed_chunk): limb loop,
# per-layer driver, embedding chunks; no parameter spill or defer (2026-09-29).
BASELINE_SCRIPT=$BASE/vit_perlayer_gpu.py
SHAFT_SCRIPT=vit_perlayer_gpu.py
SHAFT_LIMB_LOOP=1
SHAFT_EMBED_CHUNKS=16
SHAFT_INNER_ENV="SHAFT_MODEL=/vit SHAFT_MAX_LENGTH=197"
