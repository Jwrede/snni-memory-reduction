# s3_onnx_single_file_export: ONNX export once, to a file, instead of twice into a BytesIO.
#
# pool       W_vram / W_host:
#              s0_default   40.07    13.32
#              s1_limb_loop 13.83    13.23
#              s2_embed_chunk 8.89    13.25   <- host
# table      host at s2's peak:
#              870.5 MB  28.9%  heap:python3.10+0xd6be1            <- RANK 1
#              867.0 MB  28.8%  heap:libstdc++.so.6.0.29+0xf3269      the protobuf parse
#              433.3 MB  14.4%  file:...bert-base-cased-sst2/blobs     the checkpoint, mmap'd by torch
#              354.7 MB  11.8%  anon:[heap]                           located, never a target
#            rank 1 = CPython allocator serving io.BytesIO (2x the 433 MB payload, doubling growth).
#            file: row = torch mmap of /root/.cache/huggingface/.../blobs/db532512... (checkpoint).
# donor      SHAFT-CPU onnx_single_file_export_cpu (in s4_onnx_and_spill); same CrypTen and
#            nn/onnx_converter.py; port.
# context    SHAFT-CPU 17.08.: three releases during conversion (plaintext model, + malloc_trim(0),
#            protobuf initializers) left the conversion peak unchanged and raised the later peak
#            2 to 4%. This lever avoids the allocation.
# expected   rank 1 870.5 -> ~433 MB; peak up to -15% (-400 MB of 2,940,520 kB), null possible.
#            s2 spread 0.187%.
# gate       fails as s2 (phase B); no new draw or arithmetic.
SHAFT_LIMB_LOOP=1
SHAFT_EMBED_CHUNKS=16
SHAFT_LEVERS=onnx_single_file_export_gpu
#
# first attempt (17.08.) with SNNI_SPILL_DIR=/results: onnx_bytes=433533725|exports=1|fstype=gpfs;
# host peaks 3,283,444 / 3,325,248 / 2,671,944 kB (spread 19.9% vs 0.187%): GPFS write effects.
# Now default /tmp (node-local; donor used rootfs); tmpfs/ramfs/devtmpfs refused via /proc/mounts.
