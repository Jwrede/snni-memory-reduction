# s3_param_spill: encrypted parameters wait on disk instead of VRAM or host RAM.
#
# pool       rule 3 names host (W_vram 8.89, W_host 13.25 at s2); host skipped on four measurements
#            (17.08.):
#              shaft-cpu  release the plaintext model             conversion peak unchanged, inference +2 to 4%
#              shaft-cpu  the same with malloc_trim(0)            conversion peak unchanged, inference +2 to 4%
#              shaft-cpu  release the protobuf initializers       conversion peak unchanged, inference +2 to 4%
#              shaft-gpu  replace the BytesIO with a file         peak +8 to 12%, spread 0.187% -> 20%
#            Host peak set by model conversion; attacks on it made runs worse. Hence pool_skipped: host.
# object     VRAM rank 1 at s2's peak:
#              866.6 MB  54.7%  mpc.py:165:cuda <- module.py:450:cuda <- module.py:455:cuda
#              183.1 MB  11.6%  arithmetic.py:408:add
#              136.1 MB   8.6%  PRZS
#            whole encrypted model: private_model.cuda() + graph executor holding all values.
# before     param_stream_gpu (p_param_stream, p_param_stream2): VRAM 2,406,400 -> 1,695,744 kB, host
#            2.93 -> 3.53 / 4.10 GB: placement.
# donors     SHAFT-CPU encrypt_spill_cpu (866,494,480 B to files at encryption, reload in
#            Parameter.forward; in s4_onnx_and_spill, wall unchanged); MOAI-GPU s4_chunk_ffn park and
#            reload, gate byte-identical.
# unchanged  same bytes to the device, once each, same order.
# spill      /results (scratch); /proc/mounts checked, tmpfs/ramfs/devtmpfs refused; bank removed at exit.
# expected   VRAM ~ -50% (1,546,240 -> ~700,000 kB); host must not rise (one 18.9 MB share at a
#            time; cross_pool). Wall: 866 MB over 201 files in a 40 to 50 s run.
# gate       fails as s2_embed_chunk (inherited phase B); no generator or arithmetic change.
SHAFT_LIMB_LOOP=1
SHAFT_EMBED_CHUNKS=16
SHAFT_LEVERS=param_spill_gpu
SHAFT_INNER_ENV="SHAFT_PARAM_SPILL=1 SNNI_SPILL_DIR=/results"
