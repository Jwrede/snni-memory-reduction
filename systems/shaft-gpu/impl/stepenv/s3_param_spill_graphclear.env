# s3_param_spill_graphclear: parameter spill to disk + drop each graph value after its last use.
#
# reason     s3_param_spill alone (17.08., n=3):
#              LEVER|param_spill_gpu|spilled_bytes=866494480|params=201|max_one_share=178151424|loaded=201
#              vram_reserved_peak_kb = 1,546,240 in all three replicates (byte-identical to s2)
#              host peaks 2,933,700 / 2,941,640 / 2,885,100 against s2's 2,942,724 / 2,948,232 / 2,944,620
#            parameters not resident before use, peak unchanged: they accumulate after use in
#            Graph.forward's value dict (_clear_unused_values() defined, never called). Both halves
#            needed.
# object     VRAM rank 1 at s2's peak, mpc.py:165:cuda <- module.py:450:cuda <- module.py:455:cuda,
#            866.6 MB (54.7% of 1,546,240 kB); pool_skipped: host as in s3_param_spill.
# reference  SHAFT-CPU graph_clear_values: 0.02% twice (peak set by conversion, before Graph.forward).
# expected   VRAM ~ -50% toward ~700,000 kB (next object 183.1 MB); host must not rise (cross_pool).
# cost       866 MB reload over 201 files; one dict delete per node (counter instead of upstream's
#            cubic scan).
# gate       fails as s2_embed_chunk (inherited phase B); values dropped only after their last
#            consumer; graph outputs never dropped.
SHAFT_LIMB_LOOP=1
SHAFT_EMBED_CHUNKS=16
SHAFT_LEVERS=param_spill_gpu,graph_clear_values_gpu
SHAFT_INNER_ENV="SHAFT_PARAM_SPILL=1 SNNI_SPILL_DIR=/results"
