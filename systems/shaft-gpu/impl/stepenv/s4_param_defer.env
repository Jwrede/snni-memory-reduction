# s4_param_defer: materialise a parameter only when nothing else can run.
#
# object     rank 1 at s3's peak (79.0%):
#              866.6 MB  0.790  mpc.py:165:cuda <- param_spill_gpu.py:213:param_forward <- module.py:538
#               33.6 MB  0.031  matmul_limb_loop_gpu.py:57 <- generate_additive_triple
#               29.7 MB  0.027  cuda_tensor.py:610:regular_func
#            s3 lowered the device peak 1,546,240 -> 1,071,104 kB via activations; parameters still all
#            resident (now via param_forward).
# cause      _find_computable_node returns the first node with all inputs available; Parameter nodes
#            have none (all([]) is True) and come first: all 201 evaluated before any operator.
# lever      five lines: prefer a computable non-Parameter node.
# modules    param_defer_gpu carries graph_clear_values_gpu's three edits (both rewrite Graph.forward;
#            not loaded together).
# free       same nodes, same count, same dependency order; Parameter evaluation = disk read.
# gate       expected identical to s3 (= s2 byte-identical); reordering independent evaluations draws
#            nothing new.
# expected   resident parameters = one operator's need (largest share 178,151,424 B): -50% to -70%,
#            ~320 to 530 MB. s3 VRAM byte-identical over three runs.
SHAFT_LIMB_LOOP=1
SHAFT_EMBED_CHUNKS=16
SHAFT_LEVERS=param_spill_gpu,param_defer_gpu
SHAFT_INNER_ENV="SHAFT_PARAM_SPILL=1 SNNI_SPILL_DIR=/results"
