# s2_plaintext_free: release the host plaintext model after encryption.
#
# pool       at s1: W_vram 36.25 -> 10.01, W_host 10.83 -> host. Ranking:
#              anon:[heap]                    1576.6 MB   0.452 of attributed   never a step's target
#              file:db532512...(model blob)    433.3 MB   0.124                 file-backed, excluded from W
#              heap:libc10.so+0x605e5          433.0 MB   0.124                 <- THIS STEP
#              file:(deleted)                  325.1 MB   0.093                 file-backed
# object     433.0 MB = one fp32 BERT-base: crypten/nn/onnx_converter.py:64
#            crypten_model.pytorch_model = copy.deepcopy(pytorch_model) (only consumer
#            Module.to_pytorch(), nn/module.py:924-933, never called) plus the caller's model (unread
#            after from_pytorch). CPU line: 866500608 B = 2 x 433250304, named by census. After .cuda()
#            the shares are in VRAM: this is the only large named host object.
# free       past last use and duplicated; no computation; from_onnx already built the graph.
# gate       protocol reads int64 shares only; no randomness consumed. A moved gate voids the step.
# trade      none (no accuracy, security or portability change).
#
# pool_attacked: host
# object_attacked: libc10.so+0x605e5
SHAFT_LIMB_LOOP=1
SHAFT_PLAINTEXT_FREE=1
