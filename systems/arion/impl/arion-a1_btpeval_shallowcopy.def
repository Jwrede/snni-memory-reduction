Bootstrap: docker
From: golang:1.24-bookworm

# ARION step a1_btpeval_shallowcopy: arion.def plus patch_shallowcopy.py (runs after
# pin_workload.py) so workers share the evaluator's read-only DFT matrices instead of rebuilding
# them. Otherwise identical line-for-line, so a `binary_md5` diff means only the lever differs.
# See impl/levers/a1_btpeval_shallowcopy.env and impl/derive_dft_size/ for the derivation.

%files
    /scratch/tmp/j_wred02/snni_campaign/arion/pin_workload.py /opt/pin_workload.py
    /scratch/tmp/j_wred02/snni_campaign/arion/patch_shallowcopy.py /opt/patch_shallowcopy.py

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends git procps psmisc binutils python3
    rm -rf /var/lib/apt/lists/*

    cd /root
    git clone https://github.com/hangenba/Arion.git arion
    cd /root/arion
    git rev-parse HEAD > /opt/arion_commit.txt

    test -d /root/arion/bert_base_data_5

    python3 /opt/pin_workload.py /root/arion
    python3 /opt/patch_shallowcopy.py /root/arion

    go mod tidy
    go build -o arion main.go

    strings -a /root/arion/arion | grep -q 'SNNI_PARAM|' \
        || { echo "FAILED: no SNNI_PARAM marker in the binary"; exit 4; }
    strings -a /root/arion/arion | grep -q 'WORKLOAD|model=' \
        || { echo "FAILED: no WORKLOAD marker in the binary"; exit 4; }

    grep -E 'lattigo' /root/arion/go.mod > /opt/arion_lattigo.txt || true
    cat /opt/arion_lattigo.txt
    md5sum /root/arion/arion > /opt/arion_binary_md5.txt
    cat /opt/arion_binary_md5.txt

%environment
    export LC_ALL=C

%runscript
    cd /root/arion && exec ./arion
