Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m15i_enc_X_v_shrink.sif

# MOAI-CPU m16i_park_x_copy (i-line, 2026-09-21): the m15i_enc_X_v_shrink line PLUS
# one lever (patch_park_x_copy.py). Projected m15i peak = Layer-1 attention (~82-86): gal_keys live, enc_ecd_x_copy 16.9 dead until the residual add -> park (paid, disk round trip). Bit-identical.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_park_x_copy.py /opt/patch_park_x_copy.py

%post
    set -e
    python3 /opt/patch_park_x_copy.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time" layernorm_release park_x_copy; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m16i_park_x_copy
    snni.base m15i_enc_X_v_shrink
