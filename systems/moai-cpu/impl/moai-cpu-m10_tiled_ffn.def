Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m9_ct_capacity_shrink.sif

# MOAI-CPU m10_tiled_ffn: the m9 line PLUS one lever: the FFN block (linear1 -> gelu -> linear2)
# evaluated in tiles of the 3072-wide intermediate dimension, accumulating linear2 per tile, so
# the full 3072-ciphertext intermediate and gelu vectors are never resident together. Built FROM
# the m9 sif; only moai is rebuilt.
#
# WHY m10 = tiled FFN: after m9's shrink the attention phase falls to ~95 GiB and the run's peak
# moves to the FFN phases (m8 markers: after_intermediate 110.6, after_gelu 116.1, after_final
# 117.7 GiB), where the largest object is the materialised intermediate (3072 x 10.5 MB = 32 GB)
# plus its gelu output. The tiling keeps the operation order (rows 0..3071 in order) so the gate
# stays bit-identical; the earlier m9_tiled_ffn probe (built on the unfixed m8 tree, cancelled at
# bootstrap3) measured after_final 70.5 GiB against 117.7.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_tiled_ffn.py /opt/patch_tiled_ffn.py

%post
    set -e
    python3 /opt/patch_tiled_ffn.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time"; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q dead_boot_keys_release \
        && { echo "FAILED: dead_boot_keys_release present (not this step)" >&2; exit 1; } || true
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m10_tiled_ffn
    snni.base m9_ct_capacity_shrink
    snni.note fused-tiled-ffn-linear1-gelu-linear2-accumulate
