Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m1_pool_threshold.sif

# MOAI-CPU m1_scoped: m1_pool_threshold with the ct_ct matmul rotation phase routed through a local
# free-list pool (ports the earlier campaign's Exp 14 fix). PROBE, parallel to the m1-m5 line -- does
# NOT touch m1_pool_threshold's files/sif. Tests whether scoping the threshold out of the reused-buffer
# rotation path recovers the +70-80% runtime WITHOUT raising the peak (output is allocated before the
# scope, so it stays on the threshold pool). Global threshold otherwise unchanged.
#
# One edit (patch_pool_scope_matmul.py, self-validating): SwitchProfile(MMProfFixed(local pool)) around
# rot_enc_X in ct_ct_matrix_mul_diagpacking, restored before the multiply. Rebuild the project only;
# SEAL (threshold pool) inherited from the base.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_pool_scope_matmul.py /opt/patch_pool_scope_matmul.py

%post
    set -e
    python3 /opt/patch_pool_scope_matmul.py /root/moai

    cd /root/moai
    rm -rf build
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test

    strings -a /root/moai/build/test | grep -q 'SEEDED|seal_prng|' \
        || { echo "FAILED: no SEAL seed marker"; exit 4; }
    strings -a /root/moai/build/test | grep -q 'WORKLOAD|model=bert-base' \
        || { echo "FAILED: no workload marker"; exit 4; }
    strings -a /root/moai/build/test | grep -q 'LEVER|pool_threshold' \
        || { echo "FAILED: the inherited pool_threshold lever is missing"; exit 4; }
    strings -a /root/moai/build/test | grep -q 'LEVER|pool_scope_matmul' \
        || { echo "FAILED: the pool_scope_matmul lever is missing"; exit 4; }
    strings -a /root/moai/build/test | grep -q 'POOLREC|profile_installed' \
        || { echo "FAILED: the recording pool is missing"; exit 4; }
    # No reduction levers -- this is m1 + scope only, so the peak stays comparable to m1.
    strings -a /root/moai/build/test | grep -q 'LEVER|minimal_att_keys' \
        && { echo "FAILED: m1_scoped must NOT carry minimal_att_keys"; exit 4; }

    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m1_scoped
    snni.base m1_pool_threshold
