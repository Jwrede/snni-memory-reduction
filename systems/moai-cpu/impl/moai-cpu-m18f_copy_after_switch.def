Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m17f_rtn2_release_ln2.sif

# MOAI-CPU m18f_copy_after_switch (order corrected on the m16 peak, 2026-09-21): the m17f_rtn2_release_ln2 line PLUS one lever
# (patch_copy_after_switch.py). Built FROM the m17f_rtn2_release_ln2 sif; only moai is rebuilt. Projected m17 peak = run_begin transient 75.4 (two full-chain input arrays; attention 66.6, bootstraps ~66 lie below): the copy is taken after the switch to the bootstrap level. Free, bit-identical.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_copy_after_switch.py /opt/patch_copy_after_switch.py

%post
    set -e
    python3 /opt/patch_copy_after_switch.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time" layernorm_release park_att_keys enc_X_v_shrink park_x_copy dead_boot_keys_release rtn_release_ln1 copy_after_switch; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m18f_copy_after_switch
    snni.base m17f_rtn2_release_ln2
