Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m16d_copy_after_switch.sif

# MOAI-CPU m17_rtn_release_ln1: the m16 line PLUS one lever (patch_rtn_release_ln1.py): bootstrap1's
# output array is released after layernorm1, its last reader, instead of living under the whole
# second bootstrap. Built FROM the m16d sif; only moai is rebuilt.
#
# WHY m17: with all earlier levers the peak sits in bootstrap2 (m16c freeze 82.2 GiB): phase keys
# 19.8 GB (live), rtn 16.9 GB (dead), layernorm output 14.1 GB (being consumed), bootstrap
# temporaries ~19 GB, retained 6.2. rtn is the largest object with a free fix. Bit-identical.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_rtn_release_ln1.py /opt/patch_rtn_release_ln1.py

%post
    set -e
    python3 /opt/patch_rtn_release_ln1.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time" layernorm_release park_att_keys enc_X_v_shrink park_x_copy dead_boot_keys_release copy_after_switch rtn_release_ln1; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m17_rtn_release_ln1
    snni.base m16d_copy_after_switch
