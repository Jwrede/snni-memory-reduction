Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m14i_rtn_release_ln1.sif

# MOAI-CPU m15i_enc_X_v_shrink (i-line, 2026-09-21): the m14i_rtn_release_ln1 line PLUS
# one lever (patch_enc_X_v_shrink.py). With rtn and rtn2 released every Layer-0 bootstrap sits at or below the attention (m15g profile: HWM 90.6 unchanged through bootstrap4); the projected m14i peak is the Layer-1 attention (~94, Layer-0 90.6 + 3.5 lift): gal_keys live, enc_ecd_x_copy dead (paid park), enc_X_v 12.1 slack with a free fix. Free, bit-identical.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_enc_X_v_shrink.py /opt/patch_enc_X_v_shrink.py

%post
    set -e
    python3 /opt/patch_enc_X_v_shrink.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time" layernorm_release enc_X_v_shrink; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m15i_enc_X_v_shrink
    snni.base m14i_rtn_release_ln1
