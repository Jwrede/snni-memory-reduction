Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m16e_rtn_release_ln1.sif

# MOAI-CPU m17f_rtn2_release_ln2 (order corrected on the m16 peak, 2026-09-21): the m16e_rtn_release_ln1 line PLUS one lever
# (patch_rtn2_release_ln2.py). Built FROM the m16e_rtn_release_ln1 sif; only moai is rebuilt. m16 peak = bootstrap4 in-phase 82.1 GiB (m16e poller; same composition as the m17 freeze at 82.0): phase keys live, rtn2 16.9 DEAD, layernorm2 output live, bootstrap temporaries. Largest object with a free fix is rtn2, above the run_begin transient (75.4). Bit-identical.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_rtn2_release_ln2.py /opt/patch_rtn2_release_ln2.py

%post
    set -e
    python3 /opt/patch_rtn2_release_ln2.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time" layernorm_release park_att_keys enc_X_v_shrink park_x_copy dead_boot_keys_release rtn_release_ln1 rtn2_release_ln2; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m17f_rtn2_release_ln2
    snni.base m16e_rtn_release_ln1
