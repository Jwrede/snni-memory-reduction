Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m10r_dead_boot_keys_release.sif

# MOAI-CPU m11r_rtn_release_ln1 (re-measurement line in the corrected order, 2026-09-23): the m10r_dead_boot_keys_release line PLUS one lever (patch_rtn_release_ln1.py). predicted: with the dead keys gone the peak is a bootstrap phase where the previous bootstrap's output (16.9 GB, consumed by the layernorm) is dead; free.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_rtn_release_ln1.py /opt/patch_rtn_release_ln1.py

%post
    set -e
    python3 /opt/patch_rtn_release_ln1.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "rtn_release_ln1"; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m11r_rtn_release_ln1
    snni.base m10r_dead_boot_keys_release
