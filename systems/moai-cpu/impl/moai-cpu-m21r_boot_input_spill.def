Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m20r_att_keys_park_softmax.sif

# MOAI-CPU m21r_boot_input_spill (re-measurement line in the corrected order, 2026-09-23): the m20r_att_keys_park_softmax line PLUS one lever (patch_boot_input_spill.py). m20j bootstrap2 table: the bootstrap input 14.1 GB resident in full while consumed per chunk; spill (paid, rule-6 winner over chunk 64 measured on m20j).

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_boot_input_spill.py /opt/patch_boot_input_spill.py

%post
    set -e
    python3 /opt/patch_boot_input_spill.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "boot_input_spill"; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m21r_boot_input_spill
    snni.base m20r_att_keys_park_softmax
