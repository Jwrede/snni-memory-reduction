Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m23r_x_park_softmax.sif

# MOAI-CPU m24t_boot_chunk_64 (2026-09-23): the m23r_x_park_softmax line PLUS one lever (patch_boot_chunk_64.py). predicted next peak: the bootstrap plateau (53-57 GiB in all four bootstraps: phase keys 19.8, chunk temporaries ~19, retained ~8). Rule-6 candidate A: halve the chunk (temporaries), measured -3 GiB in bootstrap2 on the m20j base. Runs in parallel with candidate B (pool_threshold_256k); the better saved-per-runtime ratio is the step, the other one is ranking evidence.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_boot_chunk_64.py /opt/patch_boot_chunk_64.py

%post
    set -e
    python3 /opt/patch_boot_chunk_64.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap boot_input_spill "boot_chunk_64"; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m24t_boot_chunk_64
    snni.base m23r_x_park_softmax
