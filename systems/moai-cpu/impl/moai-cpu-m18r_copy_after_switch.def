Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m17r_park_x_copy.sif

# MOAI-CPU m18r_copy_after_switch (re-measurement line in the corrected order, 2026-09-23): the m17r_park_x_copy line PLUS one lever (patch_copy_after_switch.py). old m17 table (run start): the full-chain copy 28.2 GB, copy after the switch (free).

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_copy_after_switch.py /opt/patch_copy_after_switch.py

%post
    set -e
    python3 /opt/patch_copy_after_switch.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "copy_after_switch"; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m18r_copy_after_switch
    snni.base m17r_park_x_copy
