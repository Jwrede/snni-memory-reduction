Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m10r_dead_boot_keys_release.sif

# MOAI-CPU m11r_tiled_ffn (re-measurement line, corrected order 2026-09-24): the m10r_dead_boot_keys_release line PLUS one lever (patch_tiled_ffn.py). m10r table at its peak (gelu window, 107.1 GiB, frac 1.0): sealpool:retained 50.7 GB (the freed FFN intermediate's blocks, kept by the allocator at the HWM moment), attention keys 17.2 (live), boot_layer 16.9 (live), rtn 16.9 (FFN input, live), gelu 6.5; no free fix at this peak, so the paid FFN rewrite that never allocates the 3072-ciphertext intermediate is the step (rule 6).

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_tiled_ffn.py /opt/patch_tiled_ffn.py

%post
    set -e
    python3 /opt/patch_tiled_ffn.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink dead_boot_keys_release "FFN time"; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m11r_tiled_ffn
    snni.base m10r_dead_boot_keys_release
