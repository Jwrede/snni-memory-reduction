Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m15g_rtn2_release_ln2.sif

# MOAI-CPU m16g_enc_X_v_shrink (chain re-ordered on the final m11 peak table, 2026-09-22): the m15g_rtn2_release_ln2 line PLUS
# one lever (patch_enc_X_v_shrink.py). Built FROM the m15g_rtn2_release_ln2 sif; only moai is rebuilt. Projected m15 peak = attention (~84): enc_X_v 12.1 GB capacity slack is the largest object with a free fix. Bit-identical.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_enc_X_v_shrink.py /opt/patch_enc_X_v_shrink.py

%post
    set -e
    python3 /opt/patch_enc_X_v_shrink.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time" layernorm_release enc_X_v_shrink; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m16g_enc_X_v_shrink
    snni.base m15g_rtn2_release_ln2
