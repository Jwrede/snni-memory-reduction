Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m8_chunked_bootstrap.sif

# Fixed m8: full_3-Bootstrap-Korrektur auf die buggy phase-split+chunked-Linie (kein att-release).
# Sauberer Waterfall-Schritt m8 (chunked), korrekt, auf PALMA zen4.
%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_ps_full3_fix.py /opt/patch_ps_full3_fix.py
%post
    set -e
    python3 /opt/patch_ps_full3_fix.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap; do strings -a build/test | grep -q "$m" || { echo "FAILED: marker $m fehlt" >&2; exit 1; }; done
    strings -a build/test | grep -q att_early_release && { echo "FAILED: att-release drin (soll nicht)" >&2; exit 1; } || true
    md5sum build/test | awk '{print $1}' > /opt/moai_binary_md5.txt; cat /opt/moai_binary_md5.txt
%labels
    snni.step m8_fixed
    snni.note full3-fix-on-phase-split-chunked-no-attrelease
