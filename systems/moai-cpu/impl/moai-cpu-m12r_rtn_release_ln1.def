Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m11r_tiled_ffn.sif

# MOAI-CPU m12r_rtn_release_ln1 (re-measurement line, corrected order 2026-09-24): the m11r_tiled_ffn line PLUS one lever (patch_rtn_release_ln1.py). predicted from m10r's phase maxima: with the FFN window gone the Layer-0 bootstrap2 (96.9) is the peak, where bootstrap1's output rtn (16.9 GB, consumed by layernorm1) is dead; free (m11r measured bootstrap2 96.9 -> 82.1 for this lever).

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_rtn_release_ln1.py /opt/patch_rtn_release_ln1.py

%post
    set -e
    python3 /opt/patch_rtn_release_ln1.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink dead_boot_keys_release "rtn_release_ln1"; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m12r_rtn_release_ln1
    snni.base m11r_tiled_ffn
