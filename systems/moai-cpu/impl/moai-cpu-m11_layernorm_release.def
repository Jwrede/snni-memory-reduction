Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m10_tiled_ffn.sif

# MOAI-CPU m11_layernorm_release (corrected-order chain, 2026-09-19): the m10_tiled_ffn line PLUS one lever
# (patch_layernorm_release.py). Built FROM the m10_tiled_ffn sif; only moai is rebuilt. Rank 1 free fix at the m10 peak (layernorm1 104.4: layernorm.hpp:209 16.9 GB + :320 16.0 GB, nx and its output copy): move instead of copy, dead variance temporaries freed. Free, bit-identical.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_layernorm_release.py /opt/patch_layernorm_release.py

%post
    set -e
    python3 /opt/patch_layernorm_release.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time" layernorm_release; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m11_layernorm_release
    snni.base m10_tiled_ffn
