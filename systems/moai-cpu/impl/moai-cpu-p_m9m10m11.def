Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m8_fixed.sif

# PROBE p_m9m10m11 (not a step): m8_fixed PLUS the three candidate levers stacked, to preview the
# endpoint of the m9..m11 serial chain in one run. Levers: ct_capacity_shrink (m9 candidate),
# dead_boot_keys_release (m10 candidate), park_att_keys (m11 candidate, paid I/O). The steps
# themselves are measured one lever at a time; this image only tells whether the stacked chain
# lands under 80 GiB before three serial 30 h runs are spent.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_ct_capacity_shrink.py /opt/patch_ct_capacity_shrink.py
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_dead_boot_keys_release.py /opt/patch_dead_boot_keys_release.py
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_park_att_keys.py /opt/patch_park_att_keys.py

%post
    set -e
    python3 /opt/patch_ct_capacity_shrink.py /root/moai
    python3 /opt/patch_dead_boot_keys_release.py /root/moai
    python3 /opt/patch_park_att_keys.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink dead_boot_keys_release park_att_keys; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step p_m9m10m11
    snni.base m8_fixed
    snni.note probe-stacked-shrink-deadkeys-park
