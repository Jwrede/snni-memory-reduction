Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m19r_park_boot_layer.sif

# MOAI-CPU m20r_att_keys_park_softmax (re-measurement line in the corrected order, 2026-09-23): the m19r_park_boot_layer line PLUS one lever (patch_att_keys_park_softmax.py). m20j table (Layer-1 attention): rotation keys 17.2 GB idle during the softmax bootstrap, park (paid).

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_att_keys_park_softmax.py /opt/patch_att_keys_park_softmax.py

%post
    set -e
    python3 /opt/patch_att_keys_park_softmax.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "att_keys_park_softmax"; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m20r_att_keys_park_softmax
    snni.base m19r_park_boot_layer
