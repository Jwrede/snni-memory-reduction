Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m6r_boot_layer_release.sif

# MOAI-CPU m7r_phase_split (re-measurement line in the corrected order, 2026-09-23): the m6r line PLUS one lever (phase split of the bootstrap key bank: patch_phase_split.py + patch_softmax_phase.py + patch_ps_full3_fix.py, without the withdrawn att_output_release edit the old m7 image carried). Predicted: no free fix remains at the bootstrap peaks; the 62 GB key bank is rank 1 (paid). Phase B (equivalent).

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_phase_split.py /opt/patch_phase_split.py
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_softmax_phase.py /opt/patch_softmax_phase.py
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_ps_full3_fix.py /opt/patch_ps_full3_fix.py

%post
    set -e
    python3 /opt/patch_phase_split.py /root/moai
    python3 /opt/patch_softmax_phase.py /root/moai
    python3 /opt/patch_ps_full3_fix.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in att_keys_release_last_layer boot_layer_release phase_split; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m7r_phase_split
    snni.base m6r_boot_layer_release
