Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m14d_park_x_copy.sif

# MOAI-CPU m15d_dead_boot_keys_release (order corrected on the m11 peak table, 2026-09-20): the m14d_park_x_copy line PLUS one
# lever (patch_dead_boot_keys_release.py). Built FROM the m14d_park_x_copy sif; only moai is rebuilt. Projected m14 peak = bootstrap2 (~81) or layernorm2 (~80): at layernorm2 the dead phase-key set (14.5 GB) is the largest free fix. Free, bit-identical.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_dead_boot_keys_release.py /opt/patch_dead_boot_keys_release.py

%post
    set -e
    python3 /opt/patch_dead_boot_keys_release.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time" layernorm_release dead_boot_keys_release; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m15d_dead_boot_keys_release
    snni.base m14d_park_x_copy
