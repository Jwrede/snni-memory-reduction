Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m20j_park_boot_layer.sif

# MOAI-CPU m21j_boot_chunk_64 (paid line, 2026-09-22): the m20j_park_boot_layer line PLUS
# one lever (patch_boot_chunk_64.py). With boot_layer parked, the bootstrap temporaries (~18 GB at 128 ciphertexts in flight) are the largest reducible object at the bootstrap peaks; 64 per chunk halves them and doubles the phase-key reloads (paid). Bit-identical.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_boot_chunk_64.py /opt/patch_boot_chunk_64.py

%post
    set -e
    python3 /opt/patch_boot_chunk_64.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time" layernorm_release boot_chunk_64; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m21j_boot_chunk_64
    snni.base m20j_park_boot_layer
