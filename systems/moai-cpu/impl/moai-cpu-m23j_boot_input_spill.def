Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m22j_att_keys_park_softmax.sif

# MOAI-CPU m23j_boot_input_spill (paid line, 2026-09-23): the m22j_att_keys_park_softmax line PLUS
# one lever (patch_boot_input_spill.py). At m20's peak (Layer-0 bootstrap2) the largest object after the live phase keys is the bootstrap's own input (768 layernorm outputs, 14.1 GB), resident in full although consumed one chunk at a time; spilling the chunks after the first to disk keeps one chunk resident (paid, I/O). Rule-6 winner over boot_chunk_64 on the same peak (measured on the m20j base: bootstrap2 67.2 -> 54.5 vs 64.2, similar wall); re-measured here on its procedure predecessor. Bit-identical.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_boot_input_spill.py /opt/patch_boot_input_spill.py

%post
    set -e
    python3 /opt/patch_boot_input_spill.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time" layernorm_release att_keys_park_softmax boot_input_spill; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m23j_boot_input_spill
    snni.base m22j_att_keys_park_softmax
