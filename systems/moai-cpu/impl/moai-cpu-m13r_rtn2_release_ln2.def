Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m12r_rtn_release_ln1.sif

# MOAI-CPU m13r_rtn2_release_ln2 (re-measurement line, corrected order 2026-09-24): the m12r_rtn_release_ln1 line PLUS one lever (patch_rtn2_release_ln2.py). predicted: the mirror release for bootstrap4, where bootstrap3's output rtn2 is dead after layernorm2; free. Confirmed or replaced by m12r's own table when it lands.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_rtn2_release_ln2.py /opt/patch_rtn2_release_ln2.py

%post
    set -e
    python3 /opt/patch_rtn2_release_ln2.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink dead_boot_keys_release "rtn2_release_ln2"; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m13r_rtn2_release_ln2
    snni.base m12r_rtn_release_ln1
