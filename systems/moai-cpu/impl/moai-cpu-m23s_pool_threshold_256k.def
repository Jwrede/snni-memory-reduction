Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m22r_x_copy_release_early.sif

# MOAI-CPU m23s_pool_threshold_256k (2026-09-24): the m22r_x_copy_release_early line PLUS one lever (patch_pool_threshold_256k.py). Measured on the r-line (phase maxima, Layer 0): after x_copy_release_early the peak is the attention block's matmul window (56.5 GiB), which neither x_park_softmax (56.9, null step) nor boot_chunk_64 (57.0) touches, while the 256 KiB threshold lowers the attention to 53.9 and every bootstrap by ~4 GiB (m24r on the m23r base). Re-measured here on its procedure predecessor m22r (rule 6 winner). SEAL carries the lever, so it is rebuilt and reinstalled before the project links it (the m1 pattern).

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_pool_threshold_256k.py /opt/patch_pool_threshold_256k.py

%post
    set -e
    python3 /opt/patch_pool_threshold_256k.py /root/moai
    cd /root/moai/thirdparty/SEAL-4.1-bs
    rm -rf build
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    cmake --install build
    cd /root/moai
    rm -rf build
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap boot_input_spill x_copy_release_early "LEVER|pool_threshold_256k" 'POOLREC|profile_installed'; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m23s_pool_threshold_256k
    snni.base m22r_x_copy_release_early
