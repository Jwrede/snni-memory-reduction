Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m13_park_att_keys.sif

# MOAI-CPU m14_park_x_copy: the m13_park_att_keys line PLUS one lever (patch_park_x_copy.py). Built FROM the m13_park_att_keys sif;
# only moai is rebuilt. The residual input copy (17 GB) parked on disk through the attention block, its dead window. PAID (I/O, seconds).

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_park_x_copy.py /opt/patch_park_x_copy.py

%post
    set -e
    python3 /opt/patch_park_x_copy.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time" park_x_copy; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m14_park_x_copy
    snni.base m13_park_att_keys
