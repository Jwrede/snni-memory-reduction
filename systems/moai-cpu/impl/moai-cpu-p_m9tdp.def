Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m9_ct_capacity_shrink.sif

# PROBE p_m9tdp (not a step): the m9 line PLUS tiled FFN, dead boot-key release and attention
# key parking stacked, to preview the endpoint of the projected m10..m12 chain in one run. The
# m8 phase profile sits at 110-118 GiB in six phases (attention, layernorm1, intermediate, gelu,
# final, layernorm2); one lever per step lowers the global peak only to the next phase's level, so
# this probe answers whether the four levers together reach <=80 GiB and which phase is left.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_tiled_ffn.py /opt/patch_tiled_ffn.py
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_dead_boot_keys_release.py /opt/patch_dead_boot_keys_release.py
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_park_att_keys.py /opt/patch_park_att_keys.py

%post
    set -e
    python3 /opt/patch_tiled_ffn.py /root/moai
    python3 /opt/patch_dead_boot_keys_release.py /root/moai
    python3 /opt/patch_park_att_keys.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time" dead_boot_keys_release park_att_keys; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step p_m9tdp
    snni.base m9_ct_capacity_shrink
    snni.note probe-stacked-tiled-deadkeys-park-on-m9
