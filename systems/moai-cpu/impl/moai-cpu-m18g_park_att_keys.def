Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m17g_park_x_copy.sif

# MOAI-CPU m18g_park_att_keys (chain re-ordered on the final m11 peak table, 2026-09-22): the m17g_park_x_copy line PLUS
# one lever (patch_park_att_keys.py). Built FROM the m17g_park_x_copy sif; only moai is rebuilt. Projected m17 peak = Layer-0 bootstrap2/4 (~82 with gal_keys resident in layer 0): gal_keys 17.2 dead outside attention in non-final layers. PAID (I/O).

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_park_att_keys.py /opt/patch_park_att_keys.py

%post
    set -e
    python3 /opt/patch_park_att_keys.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time" layernorm_release park_att_keys; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m18g_park_att_keys
    snni.base m17g_park_x_copy
