Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m10_tiled_ffn.sif

# MOAI-CPU m11_dead_boot_keys_release: the m10_tiled_ffn line PLUS one lever (patch_dead_boot_keys_release.py). Built FROM the m10_tiled_ffn sif;
# only moai is rebuilt. Releases the last-loaded bootstrap phase keys when a bootstrap returns (14.5 GB dead through layernorm1 and the FFN; softmax keys dead through the next head). Free, bit-identical.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_dead_boot_keys_release.py /opt/patch_dead_boot_keys_release.py

%post
    set -e
    python3 /opt/patch_dead_boot_keys_release.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time" dead_boot_keys_release; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m11_dead_boot_keys_release
    snni.base m10_tiled_ffn
