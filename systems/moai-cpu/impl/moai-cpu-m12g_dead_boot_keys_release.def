Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m11_layernorm_release.sif

# MOAI-CPU m12g_dead_boot_keys_release (chain re-ordered on the final m11 peak table, 2026-09-22): the m11_layernorm_release line PLUS
# one lever (patch_dead_boot_keys_release.py). Built FROM the m11_layernorm_release sif; only moai is rebuilt. m11 final peak table (Layer-1 attention, 98.8 GiB): gal_keys 17.2 live, copy 16.9 dead (paid), softmax phase keys 14.5 DEAD (free), enc_X_v 12.1 (free). Largest object with a free fix: the dead phase keys. Bit-identical.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_dead_boot_keys_release.py /opt/patch_dead_boot_keys_release.py

%post
    set -e
    python3 /opt/patch_dead_boot_keys_release.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time" layernorm_release dead_boot_keys_release; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m12g_dead_boot_keys_release
    snni.base m11_layernorm_release
