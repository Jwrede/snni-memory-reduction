Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m13r_layernorm_release.sif

# MOAI-CPU m14r_tiled_ffn (re-measurement line in the corrected order, 2026-09-23): the m13r_layernorm_release line PLUS one lever (patch_tiled_ffn.py). predicted: no free fix remains at the gelu peak; the FFN intermediate (32.2 GB) is rank 1 (paid).

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_tiled_ffn.py /opt/patch_tiled_ffn.py

%post
    set -e
    python3 /opt/patch_tiled_ffn.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time"; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m14r_tiled_ffn
    snni.base m13r_layernorm_release
