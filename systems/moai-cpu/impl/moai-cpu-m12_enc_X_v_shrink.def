Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m11_dead_boot_keys_release.sif

# MOAI-CPU m12_enc_X_v_shrink: the m11_dead_boot_keys_release line PLUS one lever (patch_enc_X_v_shrink.py). Built FROM the m11_dead_boot_keys_release sif;
# only moai is rebuilt. Exactly-sized blocks for the V-input copy in single_att_block (12.1 GB -> 3.2 GB). Free, bit-identical, same technique as m9.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_enc_X_v_shrink.py /opt/patch_enc_X_v_shrink.py

%post
    set -e
    python3 /opt/patch_enc_X_v_shrink.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time" enc_X_v_shrink; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m12_enc_X_v_shrink
    snni.base m11_dead_boot_keys_release
