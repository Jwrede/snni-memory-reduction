Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m16g_enc_X_v_shrink.sif

# MOAI-CPU m17j_park_att_keys (j-line, 2026-09-21): the m16g_enc_X_v_shrink line PLUS
# one lever (patch_park_att_keys.py). m16g's Layer-1 attention stayed at or below 84.9, so its global peak is the Layer-0 FFN (84.9): there the attention rotation keys (17.2 GB, dead until the next layer's attention) outrank the packed-input copy (16.9 GB, dead until the residual add); both fixes are paid parks, rule 4 takes the larger object first. Paid (disk round trip).

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_park_att_keys.py /opt/patch_park_att_keys.py

%post
    set -e
    python3 /opt/patch_park_att_keys.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time" layernorm_release park_att_keys; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m17j_park_att_keys
    snni.base m16g_enc_X_v_shrink
