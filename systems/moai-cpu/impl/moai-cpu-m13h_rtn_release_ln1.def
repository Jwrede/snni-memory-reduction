Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m12g_dead_boot_keys_release.sif

# MOAI-CPU m13h_rtn_release_ln1 (hedge line, 2026-09-21): the m12g_dead_boot_keys_release line PLUS
# one lever (patch_rtn_release_ln1.py). Built FROM the m12g sif; only moai is rebuilt. m12g's Layer-0 bootstrap2 freeze (97.6): phase keys 19.8 live, gal_keys 17.2 dead (paid fix only in Layer 0), rtn 16.9 dead with a free fix. m11's poll trace puts Layer-0/Layer-1 bootstrap2/bootstrap4 within 0.7 GiB, so the last-layer key release (m13g) only wins if m12g's global freeze lands in Layer 1. Free, bit-identical.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_rtn_release_ln1.py /opt/patch_rtn_release_ln1.py

%post
    set -e
    python3 /opt/patch_rtn_release_ln1.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time" layernorm_release rtn_release_ln1; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m13h_rtn_release_ln1
    snni.base m12g_dead_boot_keys_release
