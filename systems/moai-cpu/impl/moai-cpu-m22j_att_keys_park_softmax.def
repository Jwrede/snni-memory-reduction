Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m20j_park_boot_layer.sif

# MOAI-CPU m22j_att_keys_park_softmax (paid line, 2026-09-23): the m20j_park_boot_layer line PLUS
# one lever (patch_att_keys_park_softmax.py). m20's peak is the Layer-1 attention block (68.5 GiB): softmax phase keys 19.8 (being read) + attention rotation keys 17.2 (idle during the softmax bootstrap). The rotation keys are parked on disk around every head's softmax bootstrap (paid, I/O). Bit-identical.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_att_keys_park_softmax.py /opt/patch_att_keys_park_softmax.py

%post
    set -e
    python3 /opt/patch_att_keys_park_softmax.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time" layernorm_release park_boot_layer att_keys_park_softmax; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m22j_att_keys_park_softmax
    snni.base m20j_park_boot_layer
