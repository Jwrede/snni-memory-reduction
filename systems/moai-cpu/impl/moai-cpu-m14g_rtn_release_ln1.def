Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m13g_att_keys_release_last_layer.sif

# MOAI-CPU m14g_rtn_release_ln1 (chain re-ordered on the final m11 peak table, 2026-09-22): the m13g_att_keys_release_last_layer line PLUS
# one lever (patch_rtn_release_ln1.py). Built FROM the m13g_att_keys_release_last_layer sif; only moai is rebuilt. Projected m13 peak = bootstrap2 (~81-84): rtn 16.9 dead (layernorm1 was its last reader). Free, bit-identical.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_rtn_release_ln1.py /opt/patch_rtn_release_ln1.py

%post
    set -e
    python3 /opt/patch_rtn_release_ln1.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time" layernorm_release rtn_release_ln1; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m14g_rtn_release_ln1
    snni.base m13g_att_keys_release_last_layer
