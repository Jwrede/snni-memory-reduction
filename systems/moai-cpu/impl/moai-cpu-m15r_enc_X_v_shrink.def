Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m14r_tiled_ffn.sif

# MOAI-CPU m15r_enc_X_v_shrink (re-measurement line in the corrected order, 2026-09-23): the m14r_tiled_ffn line PLUS one lever (patch_enc_X_v_shrink.py). predicted from the old m14 table (Layer-1 attention peak): enc_X_v's capacity slack (12.1 GB) is the largest object with a free fix. From here the cumulative lever set equals the old chain's, so the old m15..m21 tables apply.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_enc_X_v_shrink.py /opt/patch_enc_X_v_shrink.py

%post
    set -e
    python3 /opt/patch_enc_X_v_shrink.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "enc_X_v_shrink"; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m15r_enc_X_v_shrink
    snni.base m14r_tiled_ffn
