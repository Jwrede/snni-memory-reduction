Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m15d_dead_boot_keys_release.sif

# MOAI-CPU m16e_rtn_release_ln1 (order corrected on the m15 peak, 2026-09-20): the m15d_dead_boot_keys_release line PLUS one lever
# (patch_rtn_release_ln1.py). Built FROM the m15d_dead_boot_keys_release sif; only moai is rebuilt. m15 peak = bootstrap2 in-phase 82.1 GiB (m15d poller; same composition as the m16c freeze): phase keys 19.8 live, rtn 16.9 DEAD, layernorm output 14.1 live, bootstrap temporaries ~19. Largest object with a free fix is rtn. Bit-identical.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_rtn_release_ln1.py /opt/patch_rtn_release_ln1.py

%post
    set -e
    python3 /opt/patch_rtn_release_ln1.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time" layernorm_release park_att_keys enc_X_v_shrink park_x_copy dead_boot_keys_release rtn_release_ln1; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m16e_rtn_release_ln1
    snni.base m15d_dead_boot_keys_release
