Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m12d_park_att_keys.sif

# MOAI-CPU m13d_enc_X_v_shrink (order corrected on the m11 peak table, 2026-09-20): the m12d_park_att_keys line PLUS one
# lever (patch_enc_X_v_shrink.py). Built FROM the m12d_park_att_keys sif; only moai is rebuilt. Projected m12 peak = attention (95.8; bootstrap2 falls to ~81 with keys parked): largest object with a free fix there is enc_X_v (12.1 GB capacity slack). Free, bit-identical.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_enc_X_v_shrink.py /opt/patch_enc_X_v_shrink.py

%post
    set -e
    python3 /opt/patch_enc_X_v_shrink.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time" layernorm_release enc_X_v_shrink; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m13d_enc_X_v_shrink
    snni.base m12d_park_att_keys
