Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m15r_enc_X_v_shrink.sif

# MOAI-CPU m16r_park_att_keys (re-measurement line in the corrected order, 2026-09-23): the m15r_enc_X_v_shrink line PLUS one lever (patch_park_att_keys.py). old m15 table (Layer-0 bootstrap3): attention keys 17.2 GB idle through the bootstraps, park (paid).

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_park_att_keys.py /opt/patch_park_att_keys.py

%post
    set -e
    python3 /opt/patch_park_att_keys.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "park_att_keys"; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m16r_park_att_keys
    snni.base m15r_enc_X_v_shrink
