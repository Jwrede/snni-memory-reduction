Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m9_ct_capacity_shrink.sif

# MOAI-CPU m10_dead_boot_keys_release: the m9 line PLUS one lever: the last-loaded bootstrap phase
# keys are released when a bootstrap returns. Built FROM the m9 sif; only moai is rebuilt.
#
# WHY m10 = dead key release: after m9's shrink the largest object with a free fix is the phase key
# set left behind by the previous bootstrap: the softmax phase keys (385 x 37.7 MB = 14.5 GB) are
# alive through the next head's QK^T and softmax*V, the main phase keys (14.5 GB) through the FFN.
# Every consumer loads its own phase before use, so nothing computes differently. FREE, bit-identical.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_dead_boot_keys_release.py /opt/patch_dead_boot_keys_release.py

%post
    set -e
    python3 /opt/patch_dead_boot_keys_release.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink dead_boot_keys_release; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q park_att_keys \
        && { echo "FAILED: park_att_keys present (belongs to the probe, not this step)" >&2; exit 1; } || true
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m10_dead_boot_keys_release
    snni.base m9_ct_capacity_shrink
    snni.note release-last-loaded-boot-phase-keys-after-each-bootstrap
