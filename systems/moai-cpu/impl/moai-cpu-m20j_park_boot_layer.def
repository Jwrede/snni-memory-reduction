Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m19j_copy_after_switch.sif

# MOAI-CPU m20j_park_boot_layer (paid line, 2026-09-22): the m19j_copy_after_switch line PLUS
# one lever (patch_park_boot_layer.py). Endpoint table of the free line (m19g, 69.6 GiB, Layer-1 bootstrap3): phase keys 19.8 live, boot_layer 16.9 live until the second residual add, temporaries ~18, pool 7.1. No free fix remains; rule 6: paid fixes ranked by memory per runtime -> park boot_layer to disk (16.9 GB for one write+read per layer). Bit-identical.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_park_boot_layer.py /opt/patch_park_boot_layer.py

%post
    set -e
    python3 /opt/patch_park_boot_layer.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time" layernorm_release park_boot_layer; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m20j_park_boot_layer
    snni.base m19j_copy_after_switch
