Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m15_copy_after_switch.sif

# MOAI-CPU m16_layernorm_release (CANDIDATE, waiting for the m15 peak table): the m15 line PLUS
# one lever (patch_layernorm_release.py): inside layernorm/layernorm2 the normalised vector is moved
# into the output instead of copied, and the variance temporaries are freed at their last use.
# Built FROM the m15 sif; only moai is rebuilt. Free, bit-identical (moves and frees of dead objects).
# WHY: with keys released and parked, layernorm2 (m8 109.8 GiB) is projected at ~87 GiB (probe 1
# after_layernorm2 rss 87.1) and becomes the peak of the chain once attention is at ~66 (m15).

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_layernorm_release.py /opt/patch_layernorm_release.py

%post
    set -e
    python3 /opt/patch_layernorm_release.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time" dead_boot_keys_release enc_X_v_shrink park_att_keys park_x_copy copy_after_switch layernorm_release; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m16_layernorm_release
    snni.base m15_copy_after_switch
