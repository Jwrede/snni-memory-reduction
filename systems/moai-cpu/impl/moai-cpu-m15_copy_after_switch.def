Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m14_park_x_copy.sif

# MOAI-CPU m15_copy_after_switch: the m14 line PLUS one lever (patch_copy_after_switch.py). Built
# FROM the m14 sif; only moai is rebuilt. The residual copy is taken after the input is switched to
# the bootstrap level, so the run_begin transient no longer holds two full-chain arrays (75.3 GiB ->
# ~55). Free, bit-identical (mod_switch_to_next is a deterministic RNS drop).

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_copy_after_switch.py /opt/patch_copy_after_switch.py

%post
    set -e
    python3 /opt/patch_copy_after_switch.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in phase_split chunked_bootstrap ct_capacity_shrink "FFN time" dead_boot_keys_release enc_X_v_shrink park_att_keys park_x_copy copy_after_switch; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    strings -a build/test | grep -q "logn + 1" \
        && { echo "FAILED: logn + 1 still in binary (full_3 fix not applied)" >&2; exit 1; } || true
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m15_copy_after_switch
    snni.base m14_park_x_copy
