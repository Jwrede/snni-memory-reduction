Bootstrap: localimage
From: /scratch/tmp/j_wred02/snni_campaign/moai-cpu/sif/moai-cpu-m5r_att_keys_release_last_layer.sif

# MOAI-CPU m6r_boot_layer_release (re-measurement line in the corrected order, 2026-09-23): the m5r line PLUS one lever (patch_boot_layer_release.py). Predicted from m4's table: with the attention keys released in Layer 1, boot_layer (16.9 GB, dead after the second residual add) is the largest free fix at the bootstrap4 peaks. Bit-identical.

%files
    /scratch/tmp/j_wred02/snni_campaign/moai-cpu/patch_boot_layer_release.py /opt/patch_boot_layer_release.py

%post
    set -e
    python3 /opt/patch_boot_layer_release.py /root/moai
    cd /root/moai
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
    cmake --build build -j "$(nproc)"
    ls -la /root/moai/build/test
    for m in att_keys_release_last_layer boot_layer_release; do
        strings -a build/test | grep -q "$m" \
            || { echo "FAILED: marker $m missing from binary" >&2; exit 1; }
    done
    md5sum /root/moai/build/test | awk '{print $1}' > /opt/moai_binary_md5.txt
    cat /opt/moai_binary_md5.txt

%labels
    snni.system moai-cpu
    snni.step m6r_boot_layer_release
    snni.base m5r_att_keys_release_last_layer
