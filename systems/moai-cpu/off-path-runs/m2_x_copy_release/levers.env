# m2_x_copy_release: release the residual copy of the 768 input ciphertexts over its dead interval;
# re-create it before reuse. Not measured (steps.pending/); object fields open (below).
#
# pool_attacked: host
# object_attacked: Unresolved -- see "why this step cannot yet be declared" below
# object_skipped: Unresolved -- same
# cost_class: free
#
# ---------------------------------------------------------------------------------------------
# open       m1_minimal_att_keys's table:
#              226,183.2 MB  58.0%  seal::Ciphertext::operator=(...)  <- seal::util::MemoryPoolHeadMT::get()
#              130,850.0 MB  33.5%  seal::Ciphertext::resize(...)     <- seal::util::MemoryPoolHeadMT::get()
#                9,524.8 MB   2.4%  seal::Evaluator::rotate_internal(...)
#                3,952.3 MB   1.0%  test_full_scheme.hpp:554:all_layer_test() [clone ._omp_fn.0]
#            91.5% in two SEAL functions; the copy is inside Ciphertext::operator= (~12% of that row);
#            declaring that row would game the check (cf. PUMA s1_arena_cap). Cause
#            (off-path-runs/p_m1depth/, five cells): patch_minimal_att_keys.py calls a create_galois_keys
#            overload with a longer chain, shifting the fixed depth window. Instrument fixed (12-frame
#            chain, resolve_resident.py --program-root); needs an m1 re-measurement.
#
# ---------------------------------------------------------------------------------------------
# object     vector<Ciphertext> enc_ecd_x_copy(num_col);
#            for (int i = 0; i < num_col; ++i){ enc_ecd_x_copy[i] = enc_ecd_x[i]; }
#            768 cts; not redundant (original switched three more times, consumed by attention; copy
#            switched once, added as residual). Released, not removed. Lines per image
#            (`grep -n enc_ecd_x_copy /root/moai/include/test/...`):
#              image                  declare  copy   mod_switch  last read  release (commented)  overwrite
#              m1_rtn_release_early     521     523      530         752          781               1160
#              m0_default               528     530      537         765          795               1169
#              m1_minimal_att_keys      545     547      554         782          812               1186
#            base image: release at test_full_scheme.hpp:812, dead interval 783 to 1185;
#            test_full_scheme.hpp:554 row (3,952.3 MB) = the copy's mod-switch loop.
#
# ---------------------------------------------------------------------------------------------
# fix        two edits. In m1_minimal_att_keys's image:
#               810  snni_mark("after_layernorm1")
#               812  //vector<Ciphertext>().swap(enc_ecd_x_copy);     the release, commented out
#              1144  snni_mark("after_layernorm2")                    <- the peak is here
#              1182  #pragma omp parallel for
#              1186  enc_ecd_x_copy[i*6+j] = rtn2[i*6+j];             the reuse, i<128, j<6, so 0..767
#            swap leaves size 0; writes at 1186 would index an empty vector (no bounds check):
#               812   uncomment the release, and announce it       LEVER|x_copy_release|released=768
#              ~1181  `enc_ecd_x_copy.resize(num_col);` before the `#pragma omp parallel for`
#            resize default-constructs empty Ciphertexts (no data). test_single_layer.hpp:660 has the
#            release active (one layer only).
#
# ---------------------------------------------------------------------------------------------
# interval   m1 markers:
#              after_final         347,257,996        <- the copy is dead from here
#              after_bootstrap3    364,166,660   +16,908,664
#              after_layernorm2    380,746,156   +16,579,496   <- the peak
#              after_bootstrap4    380,746,156    0
#            plus after_intermediate +31,383,644, after_gelu +6,542,068: ~28.1 GB dead while the pool
#            grows ~73 GB.
# skip       rank 3 at the baseline's peak:
#              32,013.5 MB  7.8%  Ct_pt_matrix_mul.hpp:87:ct_pt_matrix_mul_wo_pre_large
#            in the producing image:
#              86            Ciphertext temp;
#              87            evaluator.multiply_plain(enc_X[j], ecd_w_j_i, temp);
#              90            evaluator.add_inplace(output[i*col_W_t+k], temp);
#            loop-local temporary under omp parallel for; no free fix (fewer threads only, paid).
#
# ---------------------------------------------------------------------------------------------
# expected   not 28.1 GB (blocks return to the pool; reuse depends on size classes). Calibration:
#            m1_rtn_release_early -3.88% (400,914,264 -> 385,346,328 kB, bigsmp): -2% to -6%.
# refuted if below the run-to-run spread (~0.53 pp, two-recorder comparison in off-path.md).
# retired    operator-bench/moai/06_free_copy: same array, disk park (paid). Here: release, no disk.
# assumption baseline ranking carried to m1 (m1 changes only rank 1, -21,935,604 kB); prediction, not
