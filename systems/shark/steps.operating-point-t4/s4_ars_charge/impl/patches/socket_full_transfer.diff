+    /* A single send() or recv() is NOT required to move everything it was asked for, and
+       MSG_WAITALL returns a SHORT count when a signal is delivered while the call is blocked.
+       The original code asserted on the full byte count from ONE syscall, so any short transfer
+       aborted the party.
+
+       Measured: with the campaign's freeze-then-measure poller attached (SIGSTOP then SIGCONT
+       around each capture), the first 14.2 MB weight exchange of the 12-layer model died at
+       once -- party 1 in recv, party 0 in send with EPIPE behind it. Without the poller the same
+       binary completed, which is what makes this a robustness bug rather than a protocol one: the
+       program was relying on the kernel never interrupting or short-changing a transfer.
+
+       Looping until complete, and retrying on EINTR, is what these two calls have to do to be
+       correct at all. It changes no buffer, no size and no byte on the wire. */
+    static ssize_t xfer_all_recv(int fd, char *buf, u64 bytes)
+    {
+        u64 done = 0;
+        while (done < bytes)
+        {
+            ssize_t n = recv(fd, buf + done, bytes - done, MSG_WAITALL);
+            if (n > 0) { done += (u64)n; continue; }
+            if (n < 0 && (errno == EINTR || errno == EAGAIN)) continue;
+            break;                      /* 0 means the peer closed; < 0 is a real error */
+        }
+        return (ssize_t)done;
+    }
+
+    static ssize_t xfer_all_send(int fd, const char *buf, u64 bytes)
+    {
+        u64 done = 0;
+        while (done < bytes)
+        {
+            ssize_t n = send(fd, buf + done, bytes - done, 0);
+            if (n > 0) { done += (u64)n; continue; }
+            if (n < 0 && (errno == EINTR || errno == EAGAIN)) continue;
+            break;
+        }
+        return (ssize_t)done;
+    }
+
