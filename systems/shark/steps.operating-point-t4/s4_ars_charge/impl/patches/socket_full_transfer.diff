-        recv(recvsocket, buf, 1, MSG_WAITALL);
+        always_assert(1 == xfer_all_send(sendsocket, buf, 1));
+        always_assert(1 == xfer_all_recv(recvsocket, buf, 1));
         bytesReceived += 1;
         bytesSent += 1;
         always_assert(buf[0] == 1);
