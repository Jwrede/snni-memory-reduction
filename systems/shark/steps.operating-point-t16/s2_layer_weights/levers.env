# s2_layer_weights
#
# basis      s1 peak 56,891,436 kB. Largest object heap:shark::Dealer::Dealer 56,416.3 MB (fix paid).
#            Largest with a free fix: heap:std::vector<shark::span<unsigned long>>::operator[], 679.7 MB =
#            all 12 layers' weights, allocated and input-shared before inference.
# object     each layer's weights read only during that layer: 11/12 held outside their use.
# lever      allocate, share and free one layer at a time in the inference loop (empty span
#            move-assignment frees; above the mmap threshold, pages return to the kernel).
# protocol   input::call consumes the dealer stream in call order; all three parties run the same
#            loop, so write and read order move together. Gate byte-identical.
# pool_attacked: host
# object_attacked: std::vector<shark::span<unsigned long>
#
# skip       Dealer::Dealer: fix works (-94.8%) but measures paid (off-path.md, off-path-runs/).
# object_skipped: shark::Dealer::Dealer
OMP_NUM_THREADS=4
