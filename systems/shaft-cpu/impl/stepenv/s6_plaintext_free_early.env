# s6_plaintext_free_early: plaintext model released before the ONNX bytes are parsed.
#
# levers     plaintext_free_early_cpu replaces plaintext_free_cpu (both replace crypten.nn.from_pytorch;
#            one line moved above from_onnx).
# table      s5's peak:
#              1110.5 MB  52.7%  anon:residual                        located, never a target
#               433.5 MB  20.6%  heap:bytes:- held_by=tuple           the ONNX serialisation
#               433.0 MB  20.6%  heap:torch:torch.float32 held_by=dict the plaintext model
#                82.6 MB   3.9%  file:libtorch_cpu.so                 library, excluded from W
#            s4's rank 1 heap:torch:torch.int64 held_by=dict (961.5 MB) is gone (s5_embed_chunk).
# skip       rank 1 = the ONNX byte buffer, input of from_onnx at the peak instant; its fix
#            (onnx_single_file_export_cpu) already applied. Rank 2 taken (same size within 0.5%).
# peak       polled maximum vs phase markers:
#              run1  peak 0.7 s before after_model_convert    inside the conversion
#              run2  peak 0.7 s before after_inference        at the end of the forward pass
#              run3  peak 0.7 s before after_model_convert    inside the conversion
#            conversion vs inference maxima:
#              run1   2,048,432   vs   2,047,080     -0.1%
#              run2   2,055,244   vs   2,072,904     +0.9%
#              run3   2,061,096   vs   2,053,316     -0.4%
# expected   conversion hump -~433 MB (~1.62 GB); published peak ~2.05 GB (0 to -1%, inference hump).
#            Diagnostic value: floor and binding phase.
# free       bytes complete first; from_onnx reads only bytes; training flag captured first.
# gate       expected to pass exactly (no draw or arithmetic change).
SHAFT_LEVERS=plaintext_free_early_cpu,triple_share_free_cpu,trace_nograd_cpu,onnx_single_file_export_cpu,encrypt_spill_cpu,embed_chunk_cpu
SHAFT_INNER_ENV="SHAFT_EMBED_CHUNKS=16"
