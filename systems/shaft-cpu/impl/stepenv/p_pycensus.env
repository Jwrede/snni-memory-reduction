# p_pycensus: diagnostic. s4 lever set plus the Python object census.
#
# reason     at s4's peak the two largest rows are _multiarray_umath.so+0x13ab14 (865.8 MB, 75 allocations)
#            and libc10.so+0x4a675 (772.8 MB, 12). Depth 2: both callers in the same library. Depth 3:
#            torch's caller in libtorch_cpu.so (535.3 MB / 9 and 237.5 MB / 3, no debug info); numpy's
#            caller stays in numpy at depths 3 and 4. The native stack does not reach the Python program.
# measures   names only: one line per live numpy array and torch tensor with its address (join with the C
#            recorder's address/size and the pagemap's resident bytes). Produces no peak.
# tracemalloc on for this probe only (creating line = rule-4 key; per-allocation traceback perturbs
#            both axes); separate flags, both in RUN_META.
SHAFT_LEVERS=plaintext_free_cpu,triple_share_free_cpu,trace_nograd_cpu,onnx_single_file_export_cpu,encrypt_spill_cpu
