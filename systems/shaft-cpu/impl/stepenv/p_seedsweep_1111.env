# p_seedsweep_1111: diagnostic. Baseline with every seed offset 0x1111: gate movement from randomness
# alone (mask-induced spread; T2 tolerance measured, not chosen; levers/probe_seed_sweep_cpu.py).
# Offset via SHAFT_INNER_ENV (only SHAFT_LEVERS and SHAFT_INNER_ENV reach the inner shell); recorded in
# RUN_META as inner_env.
SHAFT_LEVERS=probe_seed_sweep_cpu
SHAFT_INNER_ENV=SHAFT_SEED_OFFSET=0x1111
