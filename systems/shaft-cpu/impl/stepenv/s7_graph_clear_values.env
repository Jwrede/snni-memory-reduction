# s7_graph_clear_values: drop each graph value after its last consumer. On s1-s6.
# graph_clear_values_cpu must precede param_mmap_release_cpu (the first rewrites Graph.forward, the
# second wraps it).
SHAFT_LEVERS=plaintext_free_cpu,triple_share_free_cpu,beaver_reveal_inplace_cpu,graph_clear_values_cpu,param_mmap_release_cpu,onnx_single_file_export_cpu,trace_nograd_cpu
