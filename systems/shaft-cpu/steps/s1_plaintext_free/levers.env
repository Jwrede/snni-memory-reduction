# s1_plaintext_free: plaintext model released after encryption. Single pool (host).
#
# instrument C recorder resolves 71% of s0's peak to heap:libc10.so+0x4a675 (c10::alloc_cpu, allocator
#            not object). Python census triggered at the high-water: covers 3,227,852 kB (93.5%), C
#            recorder 94.8%. Shape check vs mappings: 28996*768*8 = 178,151,424 -> 178,155,520;
#            28996*768*4 = 89,075,712 -> 89,079,808. steps/s0_default/evidence/README.md.
# ranking at s0's peak (unit = what one function allocates and frees):
#   int64   held_by=dict          984.6 MB   49x(768,768) 12x(3072,768) 12x(768,3072)   <- skipped
#   float32 held_by=OrderedDict   866.1 MB   98x(768,768) 24x(3072,768) 24x(768,3072)   <- this step
#   int64   held_by=frame         238.3 MB    2x(1,128,28996) 1x(28996,768)
#   int64   held_by=tuple         178.2 MB    1x(28996,768)
#   int64   held_by=NoneType      178.2 MB    1x(28996,768)
#   float32 held_by=NoneType      143.9 MB  100x(1,128,768) 48x(1,128,3072)
# skip       encrypted set (984.6 MB): fix = per-layer streaming, paid; rule 6 free first. int64(28996,768)
#            x4 (712.6 MB) smaller than either group; three copies are Beaver operands.
# fix        crypten/nn/onnx_converter.py:64 deep-copies the plaintext model onto the CrypTen model (unused
#            export-back path); caller's reference keeps a second copy. Both released after encryption.
#            Free: encrypted weights come from the ONNX initializers, complete before release.
#
# impl_snapshot: bert_instrumented_cpu.py levers/plaintext_free_cpu.py
# Snapshot: driver plus imported lever modules, as named in shaft-cpu/impl/stepenv/s1_plaintext_free.env.
# pool_attacked: host
# object_attacked: torch:torch.float32 held_by=OrderedDict
# object_skipped: torch:torch.int64 held_by=dict
#   The encrypted parameter set, 984.6 MB. Larger than the object attacked, and dispositioned in
#   off-path.md: its mechanism is per-layer streaming and therefore paid, while this step is free.
OMP_NUM_THREADS=8
SHAFT_LEVERS=plaintext_free_cpu
