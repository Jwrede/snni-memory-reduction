 #include <llama/assert.h>
 #include <sytorch/backend/default.h>
 #include <string>
+#include <cstring>
 #include <omp.h>
 
+// D5 (dealer waterfall): weight lazy per-layer alloc. When set, large FC weights are NOT held
+// resident between ops - they are shrunk to a 1x1 stub after init and re-materialised (zeroed,
+// deterministic) just before each matmul, then shrunk again. Attacks the ~0.65 GiB base
+// (all 12 layers' weights resident from net.init). SIGMA-D6 analog. Zeroed weights are legit:
+// dealer memory is data-independent; correctness proven by determinism (two lazy runs identical),
+// not md5-identity to the eager-randomised baseline.
+extern bool g_lazyWeights;
+// Each FC layer draws its weights from its OWN deterministically seeded stream, in BOTH modes.
+// That is what makes the lazy path able to regenerate byte-identical weights on demand: the
+// eager path draws from one shared prngWeights stream, and a layer's slice of that stream cannot
+// be reproduced later without replaying every draw before it.
+extern unsigned long long g_weightSeedCtr;
+static const unsigned long long LAZY_W_MIN_ELEMS = 100000ULL;
+
 template <typename T>
 bool shapesOkay(std::vector<Tensor<T> *> &a)
 {
@@ -580,6 +595,11 @@ public:
     Tensor2D<T> Vw;
     Tensor1D<T> Vb;
 
+    // This layer's own weight seed and the scale it was initialised with, so _forward can
+    // reproduce exactly the draws _initScale made.
+    unsigned long long wseed = 0;
+    u64 wscale = 0;
+
     FC(u64 in, u64 out, bool useBias = false) : Layer<T>("FC"), in(in), out(out), weight(in, out), bias(out), inp({0, 0, 0, 0}), weightGrad(in, out), Vw(in, out), Vb(out)
     {
         this->doTruncationForward = true;
@@ -589,6 +609,12 @@ public:
     void _initScale(u64 scale)
     {
         double xavier = 1.0 / sqrt(in);
+        // Per-layer seeding is applied UNCONDITIONALLY, so the eager and lazy runs draw the same
+        // values and therefore generate byte-identical keys. Making it conditional would make the
+        // lever change the computation, which is exactly what the correctness gate rejects.
+        this->wseed = ++g_weightSeedCtr;
+        this->wscale = scale;
+        prngWeights.SetSeed(osuCrypto::toBlock(0, this->wseed));
         weight.randomize(xavier * (1ULL << scale));
         if (this->useBias)
             bias.randomize(xavier * (1ULL << (2 * scale)));
