# s3_boot_layer_release: release each boot_layer element after its last reader, so the pool holds
# 768 free blocks when layernorm2 starts allocating.
#
# pool_attacked: vram
# pool_skipped: host
# object_attacked: test.cu:70:main <- test_single_layer.cuh:868:single_layer_test()
# object_skipped: PhantomSecretKey::encrypt_zero_symmetric
# object_skipped: mod_switch_scale_to_next
# cost_class: free
#
# host skip  larger W at s2, dispositioned in off-path.md ("THE HOST LINE IS BLOCKED ON IDENTITY, NOT
#            ON LEVERS"): 90.0% anon:[heap]; largest named row Bootstrapper::genorigcoeff() 23.8 MB
#            (1.1%; W_host 108.55 -> ~107.3 if removed). Next action there: instrument (cf. SEAL_MALLOC
#            on BOLT). Host peak spread 0.29% over five runs.
# names      skip strings are substrings of the real rows
#            (secretkey.cu:275:PhantomSecretKey::encrypt_zero_symmetric(...)).
# skips      ranks 1 and 2 of s2's device table (42,316.3 MB, 33,843.8 MB): Phantom library rows
#            (off-path-runs/p_depth3/: all three frames inside Phantom). boot_layer at rank 3 is the
#            first with a free fix.
#
# ---------------------------------------------------------------------------------------------
# measured
#   peak_reserved_kb  123,928,576 -> 110,985,216   -12,943,360 kB   -10.44%
#   peak_alloc_kb     108,321,427 -> 103,046,739    -5,274,688 kB    -4.87%
#   wall                    3,342 ->       3,340 s                   -0.06%
#   host peak           2,104,588 ->   2,109,700 kB                  +0.24%
#   gate              md5 01469da3..., BYTE-IDENTICAL to s2 (T1s modulus-chain trace)
# -10.44% = 3.5x the run-to-run variation (2.94% over four runs, off-path.md); host +0.24% inside its
# 0.29% spread. peak_alloc_kb (byte-identical 108,321,427 over four runs and images) moved 4.87%:
# requested memory changed.
#
# ---------------------------------------------------------------------------------------------
# selection  p_finalprobe: published peak_vram = final reserved value of a monotone series; ranking
#            over growth events (reserved per live MiB):
#              phase                 used       reserved    ratio
#              -> before_attention  +27,648     +53,792      1.95
#              -> after_layernorm1     +768      +1,408      1.83
#              -> after_intermediate +27,648     +4,960      0.18
#              -> after_gelu         +6,144      +7,616      1.24
#              -> after_bootstrap3  +15,360        +352      0.02   <- s2's lever, near-perfect reuse
#              -> after_layernorm2     +768     +14,496     18.90   <- THIS STEP
#            s3_input_copy_fused cut the largest event 53,792 -> 43,136 MiB without lowering the peak.
#            Rule: a lever must hand freed blocks to a later request (s2: 768 MB released, pool
#            26,879.9 MB lower).
# object     boot_layer, largest program-owned row (16,911.4 MB, 15.2%, 768 allocations),
#            test_single_layer.cuh:
#              853   vector<PhantomCiphertext> boot_layer(layernorm_selfoutput_size);
#              868   boot_layer[i*6+j] = rtn[i*6+j];                      filled
#              1241  evaluator.mod_switch_to_inplace(boot_layer[i], rtn2[i].params_id());
#              1242  evaluator.add_inplace(rtn2[i], boot_layer[i]);       LAST reader
#              (never mentioned again)
#            loop serial (omp pragma commented out; patch refuses otherwise).
# free       dead after last use; nothing recomputed, reloaded, added or reordered.
#
# ---------------------------------------------------------------------------------------------
# prediction up to -14,496 MiB (~-11.8%). Measured -12,640 MiB vs s2's published peak, -14,848 MiB
#            vs p_finalprobe (s2 + markers). pool_used at after_layernorm2 88,882.1 -> 72,754.1 MiB
#            (-16,128.0 = 768 x 21 MiB: mod_switch_to_inplace had not freed it). pool_reserved 108,384 MiB
#            from after_gelu to after_bootstrap4: no growth after the GELU.
#
# ---------------------------------------------------------------------------------------------
# table after
#   site                                 s2                    this step
#   encrypt_zero_symmetric (keys)   42,316.3 MB  1121      42,316.3 MB  1121   unchanged
#   mod_switch_scale_to_next        33,843.8     2305      29,475.5     3207   -4,368.3
#   boot_layer                      16,911.4      768      16,911.4      768   UNCHANGED
#   mod_switch_to_next               8,076.1      770       8,287.9      826
#   gelu_output                      6,442.5     3072       6,427.8     3065
#
#   peak_device_bytes           110,921,141,664       105,511,472,544        -4.88%
# boot_layer live at the new peak (plateau from after_gelu, line 1084; filled at 868, released at
# 1242). mod_switch_scale_to_next shrinks (more, smaller requests served from returned blocks).
# object_attacked names the released object; the shrinking row shows the pool's reuse.
