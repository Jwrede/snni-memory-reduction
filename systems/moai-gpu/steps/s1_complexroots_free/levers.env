# s1_complexroots_free
#
# pool       W = (peak - overhead) / target:
#              W_host = 175.41   (3,336,868 kB against a derived 18,432 kB floor)
#              W_vram =   5.49   (138,739,712 kB against a derived 25,267,200 kB floor)
#            -> host (the 132.3 GiB card is within 5.5x of its floor).
# basis      s0_default host peak:
#              heap:fft.cu:12:phantom::util::ComplexRoots::ComplexRoots(unsigned long)   1,418,300 kB   42.5%
#              heap:vector.tcc:648:std::vector<unsigned long>::_M_default_append         1,407,600 kB   41.2%
#            first site: 5,455 allocations.
# source     root-of-unity table for the CKKS encoder; allocated, never freed:
#              fft.h      class ComplexRoots { cuDoubleComplex *roots_; ... };   // no destructor at all
#              fft.cu:13  roots_ = (cuDoubleComplex *) malloc((degree_of_roots_ / 8 + 1) * sizeof(...));
#              ckks.cu:72 complex_roots_ = std::make_unique<util::ComplexRoots>(util::ComplexRoots(m));
#            the temporary's buffer is shallow-copied into the unique_ptr and leaked: 266,240 B x 5,455
#            (degree 131,072) = 1.45 GB.
# lever      destructor (free(roots_)) + in-place construction; copy operations deleted (a destructor
#            alone would double-free). The image built: ckks.cu:72 was the only shallow copy.
# free       same table contents; built once, released; gate T1s (modulus-chain trace) must be
#            byte-identical.
#
# impl_lever: unpublished
# Edit (destructor in fft.h, deleted copy operations) exists only as this description; the prepared
# tree confirms the scope (fft.h, ckks.cu); no patch artifact published.
# pool_attacked: host
# pool_skipped: vram
# object_skipped: cuda_wrapper.cuh:26:void check<cudaError>(cudaError, char const*, char const*, int)
# object_attacked: PhantomCKKSEncoder::PhantomCKKSEncoder
#
# key        re-measured 2026-08-12 at host recorder depth 2 (jobs 46065355-62): the same 1385.1 MB is
#            keyed by its caller ckks.cu:72:PhantomCKKSEncoder::PhantomCKKSEncoder (depth 1:
#            fft.cu:12:phantom::util::ComplexRoots::ComplexRoots). Declaration follows the measurement
#            (as PUMA s1_arena_cap). Declared names omit file:line prefixes the table does not use
#            (substring check against the previous table's rank 1).
