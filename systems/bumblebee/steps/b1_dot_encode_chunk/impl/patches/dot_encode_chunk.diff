+// ---------------------------------------------------------------------------
+// Sliced encode (campaign step b1_dot_encode_chunk). See matmat_prot.h.
+
+int64_t MatMatProtocol::GetInnerBlocks(const Meta& meta) const {
+  auto subshape = GetSubMatShape(meta);
+  return CeilDiv(meta.dims[1], subshape[1]);
+}
+
+int64_t MatMatProtocol::GetOuterBlocks(const Meta& meta, bool for_lhs) const {
+  auto subshape = GetSubMatShape(meta);
+  // The LHS is stored row-major and its outer index is the row block (dim 0);
+  // the RHS is stored column-major and its outer index is the column block
+  // (dim 2). Those are exactly the indices DoCompute carries in its outer loop.
+  const int d = for_lhs ? 0 : 2;
+  return CeilDiv(meta.dims[d], subshape[d]);
+}
+
+template <typename Indexer>
+void MatMatProtocol::EncodeMatrixSlice(const NdArrayRef& mat, const Meta& meta,
+                                       int pivot, bool need_encrypt,
+                                       LayoutType layout, int64_t outer_bgn,
+                                       int64_t outer_end,
+                                       absl::Span<RLWEPt> out) const {
+  const int R = pivot;
+  const int C = pivot + 1;
+  auto subshape = GetSubMatShape(meta);
+  int64_t num_row_blocks = CeilDiv(meta.dims[R], subshape[R]);
+  int64_t num_col_blocks = CeilDiv(meta.dims[C], subshape[C]);
+
+  // row_major: poly_idx = rblk * num_col_blocks + cblk, so the outer index is
+  // rblk. col_major: poly_idx = cblk * num_row_blocks + rblk, so it is cblk.
+  // Either way poly_idx = outer * num_inner + inner, which is what makes a
+  // slice of outer blocks a contiguous window and lets `out` be indexed from
+  // zero here.
+  const bool outer_is_row = (layout == LayoutType::row_major);
+  const int64_t num_outer = outer_is_row ? num_row_blocks : num_col_blocks;
+  const int64_t num_inner = outer_is_row ? num_col_blocks : num_row_blocks;
+  SPU_ENFORCE(outer_bgn >= 0 && outer_bgn <= outer_end &&
+              outer_end <= num_outer);
+  SPU_ENFORCE_EQ(static_cast<int64_t>(out.size()),
+                 (outer_end - outer_bgn) * num_inner);
+
+  Shape2D mat_shape = {meta.dims[R], meta.dims[C]};
+  Shape2D submat_shape = {subshape[R], subshape[C]};
+
+  Indexer indexer(subshape, poly_deg_);
+  const int64_t num_jobs = (outer_end - outer_bgn) * num_inner;
+
+  yacl::parallel_for(0, num_jobs, [&](int64_t job_bgn, int64_t job_end) {
+    std::array<int64_t, 2> extents;
+    for (int64_t job_id = job_bgn; job_id < job_end; ++job_id) {
+      const int64_t outer = outer_bgn + job_id / num_inner;
+      const int64_t inner = job_id % num_inner;
+      const int64_t rblk = outer_is_row ? outer : inner;
+      const int64_t cblk = outer_is_row ? inner : outer;
+
+      int64_t row_start = rblk * subshape[R];
+      int64_t row_end = std::min(meta.dims[R], row_start + subshape[R]);
+      extents[0] = row_end - row_start;
+
+      int64_t col_start = cblk * subshape[C];
+      int64_t col_end = std::min(meta.dims[C], col_start + subshape[C]);
+      extents[1] = col_end - col_start;
+
+      auto flatten =
+          ConcatSubMatrix<Indexer>(mat, mat_shape, {row_start, col_start},
+                                   extents, submat_shape, poly_deg_, indexer);
+
+      vencoder_->Forward(flatten, &out[job_id], need_encrypt);
+    }
+  });
+}
+
+void MatMatProtocol::EncodeLHSSlice(const NdArrayRef& mat, const Meta& meta,
+                                    bool need_encrypt, int64_t outer_bgn,
+                                    int64_t outer_end,
+                                    absl::Span<RLWEPt> out) const {
+  EncodeMatrixSlice<LHSIndexer>(mat, meta, /*pivot*/ 0, need_encrypt,
+                                LayoutType::row_major, outer_bgn, outer_end,
+                                out);
+}
+
+void MatMatProtocol::EncodeRHSSlice(const NdArrayRef& mat, const Meta& meta,
+                                    bool need_encrypt, int64_t outer_bgn,
+                                    int64_t outer_end,
+                                    absl::Span<RLWEPt> out) const {
+  EncodeMatrixSlice<RHSIndexer>(mat, meta, /*pivot*/ 1, need_encrypt,
+                                LayoutType::col_major, outer_bgn, outer_end,
+                                out);
+}
