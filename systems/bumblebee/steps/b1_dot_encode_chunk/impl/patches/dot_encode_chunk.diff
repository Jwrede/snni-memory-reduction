+// ---------------------------------------------------------------------------
+// Sliced compute (campaign step b1_dot_encode_chunk). See matmat_prot.h.
+//
+// Each of these is the corresponding branch of DoCompute with its outer loop
+// restricted to [outer_bgn, outer_end) and the sliced side indexed relative to
+// outer_bgn. The inner accumulation over j is untouched and still ascending, so
+// every out[i,k] receives exactly the same terms in exactly the same order as
+// the unsliced code. Slicing reorders whole accumulators, never the summands
+// inside one, which is why the result is bit-identical rather than merely
+// numerically close.
+//
+// out_mat is NOT released here. DoCompute's callers release it once before
+// accumulating; a release per slice would throw away the previous slices.
+
+void MatMatProtocol::ComputeRHSSlice(absl::Span<const RLWECt> lhs_mat,
+                                     absl::Span<const RLWEPt> rhs_slice,
+                                     const Meta& meta, int64_t outer_bgn,
+                                     int64_t outer_end,
+                                     absl::Span<RLWECt> out_mat) const {
+  auto subshape = GetSubMatShape(meta);
+  SPU_ENFORCE_EQ(lhs_mat.size(), GetLeftSize(meta, subshape));
+  SPU_ENFORCE_EQ(out_mat.size(), GetOutSize(meta, subshape));
+
+  Shape3D nb;
+  for (int d : {0, 1, 2}) {
+    nb[d] = CeilDiv(meta.dims[d], subshape[d]);
+  }
+  SPU_ENFORCE(outer_bgn >= 0 && outer_bgn <= outer_end && outer_end <= nb[2]);
+  SPU_ENFORCE_EQ(static_cast<int64_t>(rhs_slice.size()),
+                 (outer_end - outer_bgn) * nb[1]);
+
+  yacl::parallel_for(outer_bgn, outer_end, [&](int64_t bgn, int64_t end) {
+    for (int64_t k = bgn; k < end; ++k) {
+      // RHS is stored column-major, and this slice starts at outer_bgn.
+      auto rhs_col = rhs_slice.data() + (k - outer_bgn) * nb[1];
+      for (int64_t i = 0; i < nb[0]; ++i) {
+        auto lhs_row = lhs_mat.data() + i * nb[1];
+        auto out_row = out_mat.data() + i * nb[2];
+        for (int64_t j = 0; j < nb[1]; ++j) {
+          FusedMulAddInplace<RLWECt, RLWECt, RLWEPt>(out_row[k], lhs_row[j],
+                                                     rhs_col[j]);
+        }
+      }
+    }
+  });
+}
+
+void MatMatProtocol::ComputeLHSSlice(absl::Span<const RLWEPt> lhs_slice,
+                                     absl::Span<const RLWECt> rhs_mat,
+                                     const Meta& meta, int64_t outer_bgn,
+                                     int64_t outer_end,
+                                     absl::Span<RLWECt> out_mat) const {
+  auto subshape = GetSubMatShape(meta);
+  SPU_ENFORCE_EQ(rhs_mat.size(), GetRightSize(meta, subshape));
+  SPU_ENFORCE_EQ(out_mat.size(), GetOutSize(meta, subshape));
+
+  Shape3D nb;
+  for (int d : {0, 1, 2}) {
+    nb[d] = CeilDiv(meta.dims[d], subshape[d]);
+  }
+  SPU_ENFORCE(outer_bgn >= 0 && outer_bgn <= outer_end && outer_end <= nb[0]);
+  SPU_ENFORCE_EQ(static_cast<int64_t>(lhs_slice.size()),
+                 (outer_end - outer_bgn) * nb[1]);
+
+  yacl::parallel_for(outer_bgn, outer_end, [&](int64_t bgn, int64_t end) {
+    for (int64_t i = bgn; i < end; ++i) {
+      // LHS is stored row-major, and this slice starts at outer_bgn.
+      auto lhs_row = lhs_slice.data() + (i - outer_bgn) * nb[1];
+      auto out_row = out_mat.data() + i * nb[2];
+      for (int64_t k = 0; k < nb[2]; ++k) {
+        auto rhs_col = rhs_mat.data() + k * nb[1];
+        for (int64_t j = 0; j < nb[1]; ++j) {
+          FusedMulAddInplace<RLWECt, RLWEPt, RLWECt>(out_row[k], lhs_row[j],
+                                                     rhs_col[j]);
+        }
+      }
+    }
+  });
+}
