# b5_ot_instances_8: paid phase, rank 2 by rule 6
#
# faithful line (2026-09-30, impl/patches/faithful_nonlinear.py); b4_slice_budget_64m peak
# 6,751,264 kB, grouped by allocating function, share of attributed total:
#   heap:BasicOTProtocols::BasicOTProtocols(std::shared_ptr<>, spu   2684.4 MB  0.389
#   heap:BasicOTProtocols::BasicOTProtocols(std::shared_ptr<>, spu   2684.4 MB  0.389
#   heap:_M_invoke  <- buffer.h:44 (discriminator 2):yacl::Buffer:    402.8 MB  0.058
#   anon:mmap-rest()                                                  186.9 MB  0.027
#   heap:MatMatProtocol::EncodeMatrixSlice<>(spu::NdArrayRef const     63.2 MB  0.009
# Numbers below: earlier placeholder-nonlinearity line (not published), same objects, same order.
# basis      largest object at the predecessor's peak: Ferret OT buffer, 5771.6 MB.
# impl_lever: none
# No source change; BB_MAX_CONCURRENCY below.
# pool_attacked: host

#
# lever      BB_MAX_CONCURRENCY 16 -> 8 (OT instances in CheetahOTState); OMP_NUM_THREADS stays 16.
#            Instance = Ferret sender + receiver adapter, 160 MiB each: -2560 MiB.
# guard      op_bench announces CONFIG|rank=N|...|max_concurrency=<value>; harness writes
#            bb_max_concurrency into RUN_META; both checked after harvest.
# manifest   BB_MAX_CONCURRENCY was pinned with OMP_NUM_THREADS on a core-count argument that
#            applies only to the latter; correction and sweep in MANIFEST.md.
# cost       paid, measured in advance: -2495 MiB for +23.1% wall = 108 MiB per %. Target floor: one
#            instance (MANIFEST.md).
# caveat     transcript +0.62 to 0.74 MB per instance removed (constant over four points; Ferret
#            setup, online phase unchanged), ~1000x the ~2e-6 within-step spread.
# object_attacked: BasicOTProtocols::BasicOTProtocols
#
# key        re-declared after the depth-5 re-measurement (2026-08-13); caller half of the
#            (caller, allocating function) key.
# measured   -2560.1 MB (one of the two OT instance groups).
OMP_NUM_THREADS=16
BB_MAX_CONCURRENCY=8
