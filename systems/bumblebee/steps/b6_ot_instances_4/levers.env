#   heap:BasicOTProtocols::BasicOTProtocols(std::shared_ptr<>, spu   1342.2 MB  0.338
#   heap:BasicOTProtocols::BasicOTProtocols(std::shared_ptr<>, spu   1342.2 MB  0.338
#   heap:_M_invoke  <- buffer.h:44 (discriminator 2):yacl::Buffer:    402.7 MB  0.101
#   anon:mmap-rest()                                                   89.3 MB  0.022
#   heap:MatMatProtocol::EncodeMatrixSlice<>(spu::NdArrayRef const     63.2 MB  0.016
# Numbers below: earlier placeholder-nonlinearity line (not published), same objects, same order.
# basis      largest object at the predecessor's peak: Ferret OT buffer, ~3200 MB.
# impl_lever: none
# No source change; BB_MAX_CONCURRENCY below.
# pool_attacked: host

#
# lever      BB_MAX_CONCURRENCY 8 -> 4 (OT instances in CheetahOTState); OMP_NUM_THREADS stays 16.
#            Instance = Ferret sender + receiver adapter, 160 MiB each: -1280 MiB.
# guard      op_bench announces CONFIG|rank=N|...|max_concurrency=<value>; harness writes
#            bb_max_concurrency into RUN_META; both checked after harvest.
# manifest   BB_MAX_CONCURRENCY was pinned with OMP_NUM_THREADS on a core-count argument that
#            applies only to the latter; correction and sweep in MANIFEST.md.
# cost       paid, measured in advance: -1370 MiB for +38.8% wall = 35 MiB per %. Target floor: one
#            instance (MANIFEST.md).
# caveat     transcript +0.62 to 0.74 MB per instance removed (constant over four points; Ferret
#            setup, online phase unchanged), ~1000x the ~2e-6 within-step spread.
# object_attacked: BasicOTProtocols::BasicOTProtocols
#
# key        re-declared after the depth-5 re-measurement (2026-08-13); caller half of the
#            (caller, allocating function) key.
# measured   -1280.0 MB.
OMP_NUM_THREADS=16
BB_MAX_CONCURRENCY=4
