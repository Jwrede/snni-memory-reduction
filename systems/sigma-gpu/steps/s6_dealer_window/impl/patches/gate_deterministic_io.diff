+// ---------------------------------------------------------------------------------------------
+// DETERMINISTIC NON-ZERO INPUT AND WEIGHTS, so that the output is sensitive to whether the
+// computation changed. Without this the run computes zero from zero and every step of every
+// waterfall reports the same trivially-correct answer, which is a check that cannot fail.
+//
+// A fixed arithmetic sequence rather than rand(): the values must be identical on both parties
+// and in every run of every step, and they must not consume the RNG stream the protocol uses.
+static inline u64 snni_fixed_value(u64 i, u64 scale, i64 den)
+{
+    // `den` maps the -1000..1000 sequence onto a fixed-point range: den=1000 gives +-1.0 (since
+    // 1.0 is 1<<scale), den=28000 gives about +-0.036, which is 1/sqrt(768), the Xavier scale for
+    // this width.
+    //
+    // THE FIRST VERSION OF THIS DIVIDED BY 1000000 AND PRODUCED A USELESS GATE. That yielded values
+    // in [-5, 4] against a 1.0 of 4096, so every input and weight was numerically zero, twelve
+    // layers of fixed-point truncation collapsed the output to exact zeros, and the observable came
+    // out as 98304 zeros. It would have reproduced perfectly across runs, so the determinism check
+    // would have PASSED on an observable with no sensitivity to the computation at all -- the same
+    // defect as the `argmax 0, 0` this patch was written to replace, one level further in.
+    //
+    // Magnitudes still have to stay small enough that twelve layers of accumulation cannot wrap the
+    // 50-bit ring, which is the truncation wraparound that made SHAFT-GPU's logits span 3.8x.
+    i64 v = (i64)((i * 2654435761ULL) % 2001) - 1000;   // -1000 .. 1000
+    return (u64)((v * (i64)(1ULL << scale)) / den);
+}
+
+template <typename T>
+static void snni_fill_deterministic(SytorchModule<T> *net, Tensor<T> &input, u64 scale)
+{
+    for (u64 i = 0; i < input.size(); ++i)
+        input.data[i] = (T)snni_fixed_value(i, scale, 1000);      // +-1.0
+
+    u64 k = 0, wt = 0, welems = 0, nodes = 0;
+    topologicalApply(net->root, [&](LayerGraphNode<T> *node, LayerGraphNode<T> *_root) {
+        ++nodes;
+        auto w = node->layer->getweights();
+        // Layers without parameters return a null ref, not an empty tensor.
+        if (w.data != nullptr)
+        {
+            ++wt;
+            welems += w.size;
+            for (u64 i = 0; i < w.size; ++i) w.data[i] = (T)snni_fixed_value(k++, scale, 28000);
+        }
+        auto b = node->layer->getbias();
+        if (b.data != nullptr)
+            for (u64 i = 0; i < b.size; ++i) b.data[i] = (T)snni_fixed_value(k++, scale, 28000);
+    });
+
+    // THE FILL REPORTS WHAT IT ACTUALLY DID, rather than leaving it to be inferred from the output.
+    // The first version of this patch produced an all-zero observable and I assumed the magnitudes
+    // were the cause; correcting them changed nothing, which means the assumption was untested. A
+    // fill that silently reaches no weights looks exactly like a fill that works, so it says so.
+    fprintf(stderr, "FILL|nodes=%lu|weight_tensors=%lu|weight_elems=%lu|input_elems=%lu|"
+                    "input[0]=%ld|input[1]=%ld\n",
+            (unsigned long)nodes, (unsigned long)wt, (unsigned long)welems,
+            (unsigned long)input.size(), (long)(i64)input.data[0], (long)(i64)input.data[1]);
+}
