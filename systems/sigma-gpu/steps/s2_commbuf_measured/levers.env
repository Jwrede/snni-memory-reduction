# s2_commbuf_measured
#
# basis      s1_nowarmup host peak 34,519,004 kB at choice time (steps.csv after re-measurement:
#            34,522,960 kB, 0.01% apart).
# pool       W_host = 155.72, W_vram = 2.92 (645,397 kB against 220,944 kB).
# impl_lever: patches/inline_03_key_buffer_high_water_reported.py patches/inline_04_commbufsize_5_gib_64_mib.py
# Lever = second file (commBufSize 5 GiB -> 64 MiB). First = p_bufhighwater probe, applied before it
# (reporting only), carried by this binary.
# pool_attacked: host
#
# table      s1 host peak, depth 2:
#              22.00 GiB  sigma.cu:242:main         keyBufSz  = 20 * OneGB, chosen per model by an if-branch
#               5.00 GiB  sigma_comms.cpp:67        commBufSize = 5 * OneGB
#               5.00 GiB  sigma_comms.cpp:68        the same constant, second buffer
#              32 of 32.9 GiB (91%) = three hardcoded constants
# probe      p_bufhighwater (job 46106974, 31 s):
#              key buffer    reserved 21,474,836,480 B (20.00 GiB)   used 18,075,947,008 B (16.83 GiB)   84.2%
#              comm buffer   reserved  5,368,709,120 B ( 5.00 GiB)   largest message 393,216 B (384 KiB)
#            key buffer 84.2% used: skipped on this number.
#
# cost_class: free
#
# cost       declared (n=1): only two buffer sizes change; wall 32 -> 29 s.
#
# object_attacked: SigmaPeer::initCommBufs
# object_skipped: main
#
# names      after symbol-table naming, same rows:
#              22.00 GiB  66.8%  main  <- gpu_mem.cu:77:cpuMalloc                    the key buffer
#              10.00 GiB  30.4%  SigmaPeer::initCommBufs(bool)  <- gpu_mem.cu:77:cpuMalloc   both comm buffers
#            `main` = key buffer at sigma.cu:242.
# measured
#              SigmaPeer::initCommBufs   10.00 -> 0.13 GiB     -9.87 GiB, and 0.13 GiB is 2 x 64 MiB
#              main (key buffer)         22.00 -> 22.00 GiB    untouched, as the skip promised
#              host peak             34,522,168 -> 24,164,104 kB   -30.0%, factor 1.428
#              wall                          32 -> 29 s
#              gate                  gate.txt, invariants.txt and gate_values.txt all byte-identical
# lever      SigmaPeer::commBufSize 5 * OneGB -> 64 MiB (170x the largest message); both buffers:
#            2 x (5 GiB - 64 MiB) = 9.87 GiB.
# safety     buffers hold one message (memSz per call: gpu_comms.h:215-251, moveIntoCPUMem /
#            exchangeShares / expandMem); getMemSz asserts memSz < commBufSize (abort on undersize).
#            Margin 170x: one measured workload (bert-base, seq=128).
# free       same messages, sizes and rounds; only unused reservation removed.
# falsifier  gate T1s (transcript invariants) must reproduce byte for byte; an abort in getMemSz
#            would mean 64 MiB is too small.
