# s1_nowarmup
#
# basis      s0_default, both pools:
#              VRAM   peak 41,943,045 kB   target   220,944 kB   W = 186.84   <- this pool
#              host   peak 34,520,532 kB   target   220,944 kB   W = 155.72
#            VRAM table (names from the measured binary, 2026-08-11; earlier `near SigmaPeer::...`
#            names were nearest exported symbols):
#              gpu_mem.cu:51:initGPUMemPool   40960.0 MB   1.000 of attributed
#              gpu_mem.cu:62:gpuMalloc            0.0 MB   0.000
#            42,949,672,960 B = exactly 40 GiB.
#
# impl_lever: patches/inline_02_warmup_allocation_removed.py
# Removes the 40 GiB warmup allocation (formerly an inline block in the build script).
# pool_attacked: vram
# object_attacked: gpu_mem.cu:51:initGPUMemPool
# cost_class: free
#
# table      re-measured 2026-08-11 (host recorder depth 2, jobs 46065347-54). s0 VRAM: two entries
#            (40960.0 MB initGPUMemPool, one call; 0.0 MB gpuMalloc). s1 VRAM: one entry, 630.3 MB at
#            gpu_mem.cu:68:gpuMalloc (working set). object_frac_of_attributed = 1.0 means one
#            allocation. Earlier names without debug_info: helper_cuda.h:585:void check<cudaError>(...)
#            in one replicate, sigma+0x5d6d8(near SigmaPeer::SigmaPeer(bool, bool)) in others; corrected.
# claim      the 65x is removal of a warm-up reservation, not reduction of a working set.
# cost       declared (one replicate): the removed allocation is written and read by nothing. Runtime
#            effect (on-demand pool growth) measured at n=1, not bounded.
# source     SigmaPeer::SigmaPeer -> initCommBufs -> initGPUMemPool (GPU-MPC/utils/gpu_mem.cu:35):
#                cudaDeviceGetDefaultMemPool(&mempool, device);
#                uint64_t threshold = UINT64_MAX;
#                cudaMemPoolSetAttribute(mempool, cudaMemPoolAttrReleaseThreshold, &threshold);
#                uint64_t *d_dummy_ptr;
#                uint64_t bytes = 40 * (1ULL << 30);
#                cudaMallocAsync(&d_dummy_ptr, bytes, 0);
#                cudaFreeAsync(d_dummy_ptr, 0);
#            40 GiB allocated and freed unused; release threshold UINT64_MAX keeps the reservation for
#            the whole run (pool warmup).
# gate       T1s (COMM/KEYS invariants); not needed for this argument.
# prior      retired campaign: 40.7 -> 1.37 GiB, no measurable runtime cost (no replicates, freeze or
#            gate); re-tested here.
# excluded   release threshold UINT64_MAX: separate retention lever, own step.
