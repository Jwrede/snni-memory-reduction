Bootstrap: docker
From: ubuntu:22.04

# BOLT (EzPC/SCI + Microsoft SEAL 4.1.1, two-party hybrid HE+MPC), second BumbleBee-paradigm impl.
# Baseline = pristine upstream + pinned seed/gate/`-g` only; `-march=x86-64-v3` caps AVX2 to match the earlier EPYC-based campaign despite PALMA's AVX-512 nodes.

%files
    /scratch/tmp/j_wred02/snni_campaign/bolt/pin_seed_and_gate.py /opt/pin_seed_and_gate.py

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        git ca-certificates build-essential g++ make cmake \
        libgmp-dev libmpfr-dev libssl-dev \
        procps psmisc python3 python3-pip unzip binutils
    rm -rf /var/lib/apt/lists/*

    # Weights (780MB, Google Drive) fetched before compiling so a network failure surfaces early.
    pip3 install --no-cache-dir gdown
    gdown 1eEiY_ywEQ2YBeFvyryk-CsLIVsTT3PC7 -O /tmp/bolt.zip
    mkdir -p /opt/bolt_data
    unzip -q /tmp/bolt.zip -d /opt/bolt_data
    rm -f /tmp/bolt.zip
    ls /opt/bolt_data/quantize/sst-2/weights_txt/ | wc -l
    test -d /opt/bolt_data/quantize/sst-2/weights_txt

    cd /opt
    git clone -b bert https://github.com/Clive2312/EzPC.git
    cd /opt/EzPC
    git rev-parse HEAD > /opt/bolt_ezpc_commit.txt

    cd /opt/EzPC/SCI
    # Done explicitly so a submodule failure is reported as one, not as a compile error.
    git submodule update --init --recursive extern/SEAL extern/eigen

    # Seed/gate/workload markers applied before compile so the measured binary carries them.
    python3 /opt/pin_seed_and_gate.py /opt/EzPC/SCI

    mkdir -p build && cd build
    cmake -DCMAKE_INSTALL_PREFIX=./install \
          -DBUILD_TESTS=ON \
          -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_CXX_FLAGS="-march=x86-64-v3 -g" \
          ..
    cmake --build . --target install --parallel "$(nproc)"
    ls -la bin/

    # Verify the binary carries what the source promised; checked marker-by-marker since a build
    # missing just one patch would otherwise still pass and silently reproduce a non-reproducible run.
    test -x /opt/EzPC/SCI/build/bin/BOLT_BERT
    strings -a /opt/EzPC/SCI/build/bin/BOLT_BERT | grep -q 'SEEDED|prg128|' \
        || { echo "FAILED: no PRG128 seed marker in the binary"; exit 4; }
    strings -a /opt/EzPC/SCI/build/bin/BOLT_BERT | grep -q 'SEEDED|prg256|' \
        || { echo "FAILED: no PRG256 seed marker in the binary (the OT extension's draw source)"; exit 4; }
    strings -a /opt/EzPC/SCI/build/bin/BOLT_BERT | grep -q 'SEEDED|seal_prng|' \
        || { echo "FAILED: no SEAL seed marker in the binary"; exit 4; }
    strings -a /opt/EzPC/SCI/build/bin/BOLT_BERT | grep -q 'GATE|logit|' \
        || { echo "FAILED: no gate marker in the binary"; exit 4; }
    readelf -S /opt/EzPC/SCI/build/bin/BOLT_BERT | grep -q debug_info \
        || { echo "FAILED: no debug_info; call sites would be inferred rather than measured"; exit 4; }

    # Record which allocation entry points this binary imports, to check the object table against
    # rather than trust it. Pattern allows an @VERSION suffix (glibc symbols are `malloc@GLIBC_2.2.5`).
    nm -D /opt/EzPC/SCI/build/bin/BOLT_BERT \
        | grep -E ' U (malloc|calloc|realloc|aligned_alloc|posix_memalign|memalign|valloc|_Znwm|_Znam)(@.*)?$' \
        | tee /opt/bolt_alloc_imports.txt
    [ -s /opt/bolt_alloc_imports.txt ] || { echo "FAILED: this binary imports no allocator entry point at all, which is either a static allocator or a broken check"; exit 4; }

    md5sum /opt/EzPC/SCI/build/bin/BOLT_BERT > /opt/bolt_binary_md5.txt
    cat /opt/bolt_binary_md5.txt

%environment
    export LC_ALL=C

%runscript
    echo "BOLT image. The harness launches bin/BOLT_BERT; see run_bolt.sh."
